	</parameter>
	<queryString><![CDATA[select
    EXT_AMOUNT as EXTENSION_EXT_AMOUNT,EXT_SERIALNO EXTENSION_EXT_SERIALNO,
    EXT_TRANSCODE as EXTENSION_EXT_TRANSCODE,
    EXT_PAYORBANKROUTNO as EXTENSION_EXT_PAYORBANKROUTNO,
    to_char(to_date(EXT_PRESENTMENTDATE,'dd/mm/yyyy'),'dd/mm/yyyy') as EXTENSION_EXT_PRESENTMENTDATE,
    EXT_EXTENSIONPERIOD as EXTENSION_EXT_EXTENSIONPERIOD,
    EXT_EXTENSIONREASONCODE as EXTENSION_EXT_REASONCODE,
    BNK_NAME as BANKMASTER_CHM_BNK_NAME,
    EXT_FILENAME as EXTENSION_EXT_FILENAME
FROM
    EXTENSION_INWARD ext,bankmaster_chm bm
WHERE
   substr(ext.EXT_PAYORBANKROUTNO,4,3)=substr(bm.BNK_ROUTING_NBR,4,3)
AND
    ext.EXT_DDMMYYYY=$P{dateString}
order by EXTENSION_EXT_FILENAME]]></queryString>

