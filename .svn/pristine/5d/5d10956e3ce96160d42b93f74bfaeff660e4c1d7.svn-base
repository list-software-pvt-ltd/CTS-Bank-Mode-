<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<%@page import="java.sql.Connection"%>
<%@page import="cts.*"%>
<%@page import="java.io.*"%>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="EN" lang="EN" dir="ltr">
<head profile="http://gmpg.org/xfn/11">
<title>CTS : Return Outward</title>
<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1" />
<meta http-equiv="imagetoolbar" content="no" />
<link rel="stylesheet" href="styles/layout.css" type="text/css" />
<script src="js/jquery-1.11.3.min.js"></script>
<script src="js/main.js"></script>
<script src="js/return_outward.js"></script>
</head>
<%
	String msg="",doICallMerge="Y";
	String btnVal="";
	
	//System.out.println("\n\tbtnVal::::>>>"+btnVal);
	Connection con=	Configuration.getConnection();
	String loginstyle="",ret="";
	try
	{
		 loginstyle=Configuration.getConfValByNm("CFG_LOGINSTYLE", con);
		btnVal=request.getParameter("btnVal");
		msg=request.getParameter("retVal").trim();
		if(msg!=null)
		{
			msg=msg.trim();
		}
		System.out.println("msg::::>>>"+msg);
		if(btnVal!=null)
		{
			btnVal=btnVal.trim();
		}
		//con.close();
	}
	catch(NullPointerException npe)
	{
		System.out.println("Message to be displayed on login form is null");		
	}	
	try
	{
		ret=request.getParameter("retString").trim();
		if(ret!=null)
		{
			ret=ret.trim();
		}
		System.out.println("ret::::>>>"+ret);
		
		String retOwdPth=Configuration.getConfValByNm("CFG_UPLOADPATH_TO_CHI",con);
		File FileList[]=new File(retOwdPth).listFiles();
		for(File f:FileList)
		{
			if(f.isFile())
			{
				if(f.getName().indexOf("RRF")>-1 && f.getName().indexOf(Configuration.getDDMMYYYY())>-1 && f.getName().indexOf(".xml")>-1)
				{
					doICallMerge="N";
				}
			}
		}
	}
	catch(Exception e)
	{
		System.out.println("Exception::----->"+e);
	}
%>
<body id="top" onload="onLoad_returnOutward()">



<jsp:include page="menu.jsp">
	<jsp:param name="htitle" value="MAIN" />
</jsp:include>

<!--<form id="form_id" name="form_id"  method="post">-->

<div id="para_form" style="border-radius: 11px 11px 11px 11px;position:absolute;width:70%;height:60%;top:30%;bottom:0%;left:20%;right:10%;border:#666666;z-index:5;background-color:rgba(213,213,229,.9);display:none;border-style:solid;">						

					<center>
					<div style="position:absolute; height:5%; width:100%; top:0%; left:0%; right:0%; bottom:0%; z-index:5" align="right"> 
					  <img src="images/close.png"  align="right" style="z-index:2" onClick="closeWindow()">
					</div>
					  <iframe id="center_frm" style="width:100%;height:100%; position:absolute; float:left; right:0%;left:0%; top:0%; bottom:0%;  margin:0; padding:0; " ><br>

					   </iframe>
					</center>
</div>

<div class="wrapper col3">
  <div id="container_chq" style="width:1000px;">
  <h1>Return Outward</h1>
  <div  class="fl_center" align="center">
	  	<div id="yespickfile">
				<input type="file" id="file_pick" name="file_pick" />
			<input id="submitbutton1" name="submitbtn"  type="button" value="Upload Files" onclick="uploadFiles()" />
		<br/><br/></div>
		<input type="hidden" id="ret" name="ret" value="<%=ret%>"/>
	</div>
	
  <div id="divhide">
  <table>
  	<tr>
  	<td>
  	<label id="lbl_indicator" style="color:#FF0000">
  			( Red Background indicates : Mismatch data of Return Outward with Clearing Inward )
  	</label>	</td>
	</tr>
		<tr>
			<td>
				<table id="retowd" width="100%">
					<tr>
						<td>

							<span style="font-weight:bold">SrNo</span>														
						</td>
						<td>
							<span style="font-weight:bold">Cheque No.</span>
						</td>
						<td>
							<span style="font-weight:bold">Sort Code</span>
						</td>
						<td>
							<span style="font-weight:bold">Tran Code</span>
						</td>
						<td>
							<span style="font-weight:bold">Amount (In Rs.)</span>
						</td>
						<td>
							<span style="font-weight:bold">Reason Code</span>
						</td>
						<td>
							<span style="font-weight:bold">Reason Comment</span>
						</td>
					</tr>
				</table>
				
				<table id="TotalAmount" width="100%" border="0">				
					<tr id="grandAmt" align="right">								
						<td  width="50%"><span style="font-weight:bold">Grand Total:</span></td>
						<td id="gdAmt" align="left"  width="25%">
							<input  style="font-weight:bold;" type="text" name="grdAmt" id="grdAmt" value="0.0" disabled="disabled" readonly="true" style="border:none;background:transparent"/>
						</td>
						<td align="left">
				<label style="font-family:'Times New Roman', Times, serif;font-size:16px;text-decoration:blink;color:#FF0000">
				<a href="#" onclick="show_warning()" style="color:#FF0000;text-decoration:underline">Warning</a>
			</label>
						</td>
					<tr>
				</table>
				
			</td>
		</tr>
		<tr style="width:100%">			
			<td style="width:10%" align="left">
				<input type="button" name="Merge" id="submitbutton" value="Convert" onclick="upload_return_outward()" />
				<!--<input type="button" name="Merge" id="submitbutton" value="Convert" onclick="updateRetOwdData()" />-->
				<!--<input type="button" name="Merge" id="submitbutton" value="Update And Convert" onclick="updateRetOwdData()" />-->
			</td>
			<!--<td align="left" id="msgtd">
			
			</td>-->
			<input name="session_loginid" id="session_loginid" type="hidden" value="<%=session.getAttribute("session_loginid")%>">
<input name="session_branch_code" id="session_branch_code" type="hidden" value="<%=session.getAttribute("session_branch_code")%>">
	<input type="hidden" id="loginstyle" name="loginstyle" value="<%=loginstyle%>"/>
	  	</tr>
		
  </table>
  </div>
  </div>
</div>
<input type="hidden" id="rcnt" name="rcnt" value="1"/>
<input type="hidden" id="btnVal" name="btnVal" value="<%=btnVal%>"/>
<input type="hidden" id="retstr" name="retstr" value="returnOutward"/>


<input type="hidden" id="data" name="data" value="null"/>
<!--</form>-->
<div id="footer">
		
		<a href="javascript:showLogin()">
		<label style="color:#059BD8"> &nbsp;&nbsp;Logout</label> </a>
		 <jsp:include page="footer.jsp"></jsp:include>
</div>

<%
		System.out.println("Message:"+msg);
	try
	{
	if(msg.length()>0)
	{%>
		<input type="hidden" id="hdMsg1" name="hdMsg1" value="<%=msg%>"/>
	<%}
	else
	{%>
		<input type="hidden" id="hdMsg1" name="hdMsg1" value="N"/>
	<%}
	}
	catch(NullPointerException npe)
	{%>
		<input type="hidden" id="hdMsg1" name="hdMsg1" value="N"/>
	<%
		System.out.println("Message to be displayed on form is null");
	}
%>
	<input type="hidden" id="hddoICallMerge" name="hddoICallMerge" value="<%=doICallMerge%>"/>
	
</body>
</html>
