<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<%@page import="cts.*"%>
<%@page import="java.sql.*"%>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="EN" lang="EN" dir="ltr">
<head profile="http://gmpg.org/xfn/11">
<title>CTS : Inward Clearing</title>
<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1" />
<meta http-equiv="imagetoolbar" content="no" />
<script src="js/jquery-1.11.3.min.js"></script>
<link rel="stylesheet" href="codebase/dhtmlx.css" />
<link rel="stylesheet" href="styles/layout.css" type="text/css" />
<script src="codebase/dhtmlx.js"></script>
<script src="codebase/dhtmlxgrid_json.js"></script>
<script src="js/inward_clearing.js"></script>
<style type="text/css">
#img_frnt {
  -moz-transition: transform 1s;
  -webkit-transition: transform 1s;
  transition: transform 1s;
}
#img_frnt1 {
  -moz-transition: transform 1s;
  -webkit-transition: transform 1s;
  transition: transform 1s;
}

.flip {
  transform: rotate(-180deg);
}
</style>
</head>
<%
	Connection con=Configuration.getConnection();
	String CFG_downloadpath_from_CHI=Configuration.getConfValByNm("CFG_downloadpath_from_CHI",con);
	String loginstyle=Configuration.getConfValByNm("CFG_LOGINSTYLE", con);
	con.close();
	String msg="";
	String userRole="",retStr="",Flag="";
	String branchCode=(String)session.getAttribute("session_branch_code");
	try
	{
		msg=request.getParameter("msg").trim();
		System.out.println("msg===="+msg);	
	}
	catch(NullPointerException npe)
	{
		System.out.println("Message to be displayed on inward_clearing form msg is null");
	}			
	try
	{
		retStr=request.getParameter("retStr").trim();
		System.out.println("@@@@@@@@@@@@@retStr==="+retStr);
		Flag=request.getParameter("Flag").trim();
		System.out.println("@@@@@@@@@@@@@Flag==="+Flag);
		userRole=session.getAttribute("session_user_role").toString();
		System.out.println("######################## userRole:"+userRole+"#####");
	}
	catch(NullPointerException npe)
	{
		System.out.println("Message to be displayed on inward_clearing userRole is null");		
	}	
%>
<!--<body id="top" >
-->

<body id="top" onload="onload_inward_clearing()">

<jsp:include page="menu.jsp">
	<jsp:param name="htitle" value="MAIN" />
</jsp:include>
<!--                -->


<!--                -->
<div class="wrapper col3">
  <div id="container_chq" style="width:98%">
  
  	<div  class="fl_center" align="center">
	  	<div id="yespickfile">
				<input type="file" id="file_pick" name="file_pick[]" size="80" multiple="multiple" />
				<input type="hidden" id="filenames" name="filenames" value=""/>
				<input id="submitbutton1" name="submitbtn"  type="button" value="Upload Files" onclick="uploadFiles()" />
			<input type="hidden" id="retStr" name="retStr" value="<%=retStr%>"/>
			<input type="hidden" id="Flag" name="Flag" value="<%=Flag%>"/>
				<br/><br/>
		</div>
	</div>
  
  
	<table width="100%" height="100%" border="1" cellspacing="1" cellpadding="1" id="divhide">
		<tr class="2" >
			<td width="30%" height="40%" colspan="2">
			<!--<div class="fl_left">-->
			<div class="fl_left" style="float:left; width:50%;">
					<label id="list_filenames" style="font-weight:bold">File Names</label>
					<ul id="ul_list" type="disc">
					 
					</ul>
			</div>
		
			<div class="fl_left" style="width:20%; left:45%;" id="sub_btn">
					
					<input id="submitbutton" type="button" name="btn_download"  value="Convert & Save" onclick="download_inward_cheques()" />
			</div>
			
			<div class="fl_right" style="width:25%;left:70%;" >
				<table >
					<tr>
						<td>Total Cheque </td>
						<td>Total Amount </td>
					</tr>
					
					<tr>
						<td id="totalCheques"></td>
						<td id="totalAmount"></td>
					</tr>

				</table>
				
				<table border="0" >
					<tr> 
						<td>Clearing type:</td>				
					</tr>
				</table>

				<table border="0" >					
					<tr id="trId">			
					</tr>
				</table>
			</div>	
			</td>
			
		</tr>
		<tr id="viewType" name="viewType" style="visibility: hidden;">
			<td colspan="2">
				<table align="center">
						<tr align="center">
							<td><label style="font-weight:bold">Classic Style</label><input checked="checked" type="radio" name="classic_style" id="classic_style" onclick="classicStyle()"/>&nbsp;&nbsp;
							<label style="font-weight:bold">Grid Style</label><input type="radio" name="grid_style" id="grid_style" onclick="getGridData()"/>
							</td>
						</tr>
						
					</table>
			</td>
					
		</tr>
		<tr id="classicData" name="classicData" style="display: none;">
			<td width="20%" height="100px">
				<table cellpadding="0"  cellspacing="0" align="center" style="width:100%">
						<tr>
							<td><label style="font-weight:bold">ChequeNo_SortCode</label></td>
							<!--<td colspan="2" align="right">--><!--Select All<input id="chk_selall" type="checkbox" onClick="toggle_in_clearing(this)" title="Select All"/> </td>-->
							
						</tr>
					</table>
				<div id="div_in_chq" style="overflow:scroll; height:300px; position:relative ; padding:0;">				
					<table id="tab_in_chq" cellpadding="0"  cellspacing="0" border="1" align="center" style="border-color:#FFFFFF; width:100%">
						<tr id="tr_select_all">
							<!--<td>ChequeNo_SortCode</td>-->
							<td colspan="2" align="right"><!--Select All<input id="chk_selall" type="checkbox" onClick="toggle_in_clearing(this)" title="Select All"/>--></td>
						</tr>
					</table>
				</div>	
			</td>
			<td style="width:1065px" height="40%" rowspan="2" align="center">
				<div class="fl_left" align="center">
					<img  class="toggle" id = "img_frnt" style="width:80%;height:10%" onclick="rotateImage()"> 
				</div>
				
				<div style="float:left;width:100%">
						<table border="1" id="tab_co_cbs_datanew" style="width:100%" cellpadding="0" cellspacing="0">
								<tr id="tr_headernew">
									<td>Cheque No</td>
									<td>Sort Code</td>
									<td>Tran Code</td>
									<td>Amount(in Rs.)</td>
									<td>Account Number</td>
								</tr>																	
							</table>
					</div>
					<div style="float:left;width:100%">
						<label style="color: red;">Click On Image For Rotate</label>
					</div>
			</td>
			<!--<td height="100px"width="70%">
				<div id="div_cheque" style="width:100%;height:100%;position:relative;zIndex:1">	
		
					<fieldset>
					
						
						
						<div class="fl_left">
							<table>
								<tr>
									<td style="width:100%;height:50%">
									<img id="img_enlarged" style="width:100%;height:60%">  
									
									</td>
								</tr>
							</table>
						</div>
					
						<div class="fl_left">
							
						</div>
					
					</fieldset>
			
				</div>
			</td>-->
		</tr>
		<tr id="gridData" name="gridData" style="display: none;" class="2">
			<td width="30%" height="40%">
			<div id="filejsongrid" style="width: 670px; height:300px;display: inline-block;" >
			</div>
			<div class="fl_right" style="width:47%; left:20%;">
					<img id = "img_frnt1" style="height:300px;" onclick="rotateImage()"><!-- 300px -->
			</div>
			<div>
			<label style="font-weight:bold">Number Of Cheque : </label><input type="text" name="noOfchek" id="noOfchek" style="width: 5%" readonly="readonly"/> &nbsp;&nbsp;
			<label style="font-weight:bold">Total Amount : </label><input type="text" name="TotAmt" id="TotAmt" readonly="readonly" style="width: 15%"/>&nbsp;&nbsp;&nbsp;
			&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
			<label style="color: red;">Click On Image For Rotate</label>
			</div>
			</td>
					
		</tr>
	</table>
  </div>
</div>
<input type="hidden" id="rcnt" name="rcnt" value="1"/>
<input type="hidden" id="selClrType" name="selClrType"" value="1"/>
<input type="hidden" id="rotateImgName" name="rotateImgName"" value=""/>
<input type="hidden" id="hd_selectCnt" name="hd_selectCnt" value="1"/>
<input type="hidden" id="hd_down_path" name="hd_down_path" value="<%=CFG_downloadpath_from_CHI%>"/>
<input name="session_loginid" id="session_loginid" type="hidden" value="<%=session.getAttribute("session_loginid")%>"/>
<input name="session_branch_code" id="session_branch_code" type="hidden" value="<%=branchCode%>"/>	

<input name="session_user_role" id="session_user_role" type="hidden" value="<%=session.getAttribute("session_user_role")%>"/>
<input type="hidden" id="loginstyle" name="loginstyle" value="<%=loginstyle%>"/>
<div id="footer">
		<!-- <p>(c) 2014 Developed by <a href="http://listspl.co.in/"><label style="color:#FFFFFF; cursor:pointer;">LIST Software Pvt. Ltd.</label></a><a href="javascript:showLogin()"><label class="labels" style="color:#059BD8; cursor:pointer;"> &nbsp;&nbsp;Logout</label></a><br/></p>
			Version 2017.1.0<br/> -->
			<a href="javascript:showLogin()"><label style="color:#059BD8"> &nbsp;&nbsp;Logout</label> </a>
			 <jsp:include page="footer.jsp"></jsp:include>
</div>


<%
System.out.println("Message:"+msg);
	try
	{
	if(msg.length()>0)
	{%>
	<input type="hidden" id="hdMsg1" name="hdMsg1" value="<%=msg%>"/>
	<%}
	else
	{%>
	<input type="hidden" id="hdMsg1" name="hdMsg1" value="N"/>
	<%}
	}
	catch(NullPointerException npe)
	{%>
	<input type="hidden" id="hdMsg1" name="hdMsg1" value="N"/>
	<%
	System.out.println("Message to be displayed on form is null");
	}
%>


</body>
</html>
