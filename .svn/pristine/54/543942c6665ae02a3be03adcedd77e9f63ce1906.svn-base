	<parameter name="dateString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["01012014"]]></defaultValueExpression>
	</parameter>
	<parameter name="branchString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="bankName" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT
   distinct  RETRUNOUTWARD."RTO_BOFD" AS RETRUNOUTWARD_RTO_BOFD,
     RETRUNOUTWARD."RTO_CHEQUENO" AS RETRUNOUTWARD_RTO_CHEQUENO,
     RETRUNOUTWARD."RTO_SORTCODE" AS RETRUNOUTWARD_RTO_SORTCODE,
     RETRUNOUTWARD."RTO_TRANSACTIONCODE" AS RETRUNOUTWARD_RTO_TRANSACTIONC,
     RETRUNOUTWARD."RTO_AMOUNT" AS RETRUNOUTWARD_RTO_AMOUNT,
     RETRUNOUTWARD."RTO_ACCOUNTNUMBER" AS RETRUNOUTWARD_RTO_ACCOUNTNUMBE,
     TO_CHAR(TO_DATE(RETRUNOUTWARD."RTO_DDMMYYYY",'DD/MM/YYYY'),'DD/MM/YYYY') AS RETRUNOUTWARD_RTO_DDMMYYYY,
     substr(RETRUNOUTWARD."RTO_XMLFILENAME",1,29) AS RETRUNOUTWARD_RTO_XMLFILENAME,
      RETRUNOUTWARD."RTO_RETURNREASONCODE"||'--'||SUBSTR(RETDESCR, 1,decode((INSTR(RETDESCR, '(' )-1),'-1',length(RETDESCR) , (INSTR(RETDESCR, '(' )-1)))
	|| decode(RETRUNOUTWARD."RTO_RETURNREASONCODE",'88','('||RETRUNOUTWARD."RTO_RETREASONCOMMT"||')',' ') 
AS RETRUNOUTWARD_RTO_RETURNREASON,
     CLEARINGINWARD."CLI_PAYORBANKROUTNO" AS CLEARINGINWARD_CLI_PAYORBANKRO,
     CLEARINGINWARD."CLI_SERIALNO" AS CLEARINGINWARD_CLI_SERIALNO,
     RETRUNOUTWARD."RTO_PAYORBANKROUTNO" AS RETRUNOUTWARD_RTO_PAYORBANKROU,
     BRANCHMSTR."BRM_BRNCD"||'--'|| BRANCHMSTR."BRM_BRNNM" AS BRN_CD_NAME
FROM
     "RETRUNOUTWARD" RETRUNOUTWARD,
     "CLEARINGINWARD" CLEARINGINWARD,
     "BRANCHMSTR" BRANCHMSTR,
     "RETINWRETCODES" RETINWRETCODES
WHERE
     RETRUNOUTWARD."RTO_CHEQUENO" = CLEARINGINWARD."CLI_SERIALNO"
AND RETRUNOUTWARD."RTO_PAYORBANKROUTNO"= CLEARINGINWARD."CLI_PAYORBANKROUTNO"
AND
   CLEARINGINWARD."CLI_PAYORBANKROUTNO"=BRANCHMSTR."BRM_MICRCD"
AND
  RTO_RETURNREASONCODE=RETCODE
AND
   RETRUNOUTWARD."RTO_DDMMYYYY"=$P{dateString}
AND
   BRANCHMSTR."BRM_BRNCD"=$P{branchString}
order by
RETRUNOUTWARD_RTO_XMLFILENAME ASC]]></queryString>

