				{
				  System.out.println("\nIOException in Engine.generateRRF():"+ie.getMessage());
				  retVal="FAIL2#";
				}
				catch (Exception ie)
				{
					ie.printStackTrace();
				  System.out.println("\nException in Engine.generateRRF():"+ie.getMessage());
				  retVal="FAIL3#";
				}
				finally
				{
					try
					{
				  if (xtw != null)
					  	xtw.close();
				  if(rs!=null)
					  	rs.close();
				  if(psInsert!=null)
					  psInsert.close(); 
				  
				  /*if(con!=null )
					  con.close();*/
				  if(psUpdate==null)
					  psRO.close();
				  	psUpdate.close();
					}
					catch(Exception e)
					{
						}
				}
				System.out.println("Exit from generateRRF ..."+retVal);
				return retVal;
	}//generateRRF

	public String generateRET()
	{

		System.out.println("*** inside generateRET *****");
		String retVal="";
		String singleRecord="";

		String RET_name= GetFileName.getReturnFileName_HDFC("",con);
		String[] strArr=RET_name.split("_");
		String creationDate=strArr[2];
		String creationTime=strArr[3];
 		File strFile = new File(Configuration.getConfValByNm("CFG_uploadpath_to_chi",con)+"/"+RET_name);
 		boolean fileCreated ;
 		//File appending
 		Writer objWriter=null ;
 		 PrintWriter pw1=null;

		String str_RET_name=RET_name;
		String RET_done_name=RET_name+".done";
		String fileId=RET_name.substring(RET_name.lastIndexOf("_")+1,RET_name.lastIndexOf("."));

		long totAmt = 0;
		int totChq = 0;
		PreparedStatement psInsert=null;
		PreparedStatement psUpdate=null;
		PreparedStatement psexecute=null;
		PreparedStatement psRO=null;
		ResultSet rs=null,rs_count=null;
		FileOutputStream fos=null;
		//Connection con=null;

		int returnOutwardRecCount=0;
		try
		{
				fileCreated = strFile.createNewFile();
				fos=new FileOutputStream(strFile);
				pw1 = new PrintWriter(fos);

				//con=Configuration.getConnection();
				psRO=con.prepareStatement("select count(*) from RETRUNOUTWARD where RTO_DDMMYYYY=? and RTO_STATUS='Y'");
				psRO.setString(1,Configuration.getDDMMYYYY());
				rs_count=psRO.executeQuery();
				while(rs_count.next())
				{
					returnOutwardRecCount=rs_count.getInt(1);
				}
				System.out.println("\n\t returnOutwardRecCount:"+returnOutwardRecCount);
				//psInsert=con.prepareStatement("Insert into RETRUNOUTWARD values(?,?,?,?,?,?,?,?,?)");
				psUpdate=con.prepareStatement("Update RETRUNOUTWARD set RTO_STATUS='D',RTO_XMLFILENAME='"+str_RET_name+"' where RTO_DDMMYYYY='"+Configuration.getDDMMYYYY()+"' and RTO_CHEQUENO=? and RTO_PAYORBANKROUTNO=? and to_number(RTO_TRANSACTIONCODE)=to_number(?) and to_number(RTO_AMOUNT)=? and RTO_CLEARINGTYPE=? and RTO_STATUS='Y'");
				String rec = "";
				Statement st=con.createStatement(ResultSet.TYPE_SCROLL_INSENSITIVE,ResultSet.CONCUR_READ_ONLY);

				String sql="Select r.RTO_BOFD,r.RTO_CHEQUENO,r.RTO_PAYORBANKROUTNO,";
				sql=sql+ "r.RTO_SORTCODE,r.RTO_TRANSACTIONCODE,r.RTO_AMOUNT,r.RTO_ACCOUNTNUMBER,r.RTO_RETURNREASONCODE,";
				sql=sql+" c.CLI_CLEARINGTYPE,c.CLI_ITEMSEQUENCENO,c.CLI_PRESENTMENTDATE,c.CLI_CYCLENO,";
				sql=sql+"c.CLI_ACCOUNTNO,c.CLI_PRESENTINGBANKROUTNO,c.CLI_BOFDRoutNo,c.CLI_BOFDBUSDATE,";
				sql=sql+ "c.CLI_DEPOSITORACCT,c.CLI_IFSC,C.CLI_INSTRUMENT_ID";
				sql=sql+" from RETRUNOUTWARD r, CLEARINGINWARD c";
				sql=sql+" where r.RTO_STATUS='Y'";
				sql=sql+" and r.RTO_DDMMYYYY=to_char((select max(to_date(c.CLI_DDMMYYYY,'ddmmyyyy')) ";
				sql=sql+" from CLEARINGINWARD CL WHERE CL.CLI_SERIALNO=c.CLI_SERIALNO AND ";
				sql=sql+" c.CLI_PAYORBANKROUTNO=CL.CLI_PAYORBANKROUTNO AND c.CLI_CLEARINGTYPE";
				sql=sql+" =CL.CLI_CLEARINGTYPE and c.CLI_TRANSCODE=CL.CLI_TRANSCODE  ";
				sql=sql+" and c.CLI_AMOUNT = CL.CLI_AMOUNT  ),'ddmmyyyy') ";
				sql=sql+" and r.RTO_DDMMYYYY='"+Configuration.getDDMMYYYY()+"'";
				sql=sql+" and r.RTO_CHEQUENO=c.CLI_SERIALNO";
				sql=sql+" and r.RTO_PAYORBANKROUTNO=c.CLI_PAYORBANKROUTNO";
				sql=sql+" and r.RTO_CLEARINGTYPE=c.CLI_CLEARINGTYPE ";
				sql=sql+" and to_number(r.RTO_TRANSACTIONCODE)=to_number(c.CLI_TRANSCODE)  ";
				sql=sql+" and to_number(r.RTO_AMOUNT)=to_number(c.CLI_AMOUNT)";
				//sql=sql+" and r.RTO_ITEMSEQUENCENO=c.CLI_ITEMSEQUENCENO";
				sql=sql+" and nvl(rtrim(ltrim(r.RTO_ITEMSEQUENCENO)),c.CLI_CLRSRNO)=c.CLI_CLRSRNO";//CLI_ITEMSEQUENCENO

				System.out.println("sql:"+sql);
				rs=st.executeQuery(sql);
				//xof =  XMLOutputFactory.newInstance();
				String micrFile=RET_name;
				//path where to generaete RRF.xml
				String path_ret= Configuration.getConfValByNm("CFG_uploadpath_to_chi",con);


					//get no of record in resultset
							int size = 0;
						if(rs.next())
						{
							rs.last();
							size = rs.getRow();
							rs.beforeFirst();
						}

						System.out.println("size:::>>>"+size);
				//now get one by one record and generate RET..

					int counter=0;
					String statusStr="";
					if(size>0)
					{//1
						//this condition decide wheather return outward cheques and clearinginward cheques  having same count or not
						if(returnOutwardRecCount==size)
