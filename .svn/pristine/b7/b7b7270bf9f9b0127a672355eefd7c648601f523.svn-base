												//String signatureData=Configuration.micrEncryptedData(signatureString);
												//String signatureLength=Integer.toString(Configuration.dasLength);

											//create xml tags


												xtw.writeStartElement("Item");
												xtw.writeAttribute("ItemSeqNo",itemSeqNo);
												//MICR Data
												//System.out.println("sortCode:"+sortCode);
												/*if(sortCode.length()==0||Integer.parseInt(sortCode.trim())==0)
												{

													statusStr="PayorBankRoutNo must Not Zero";
													System.out.println(statusStr);
													break;


												}
												else*/
												{
													xtw.writeAttribute("PayorBankRoutNo",payorBankRoutNo);
												}
												System.out.println("amount:"+amount);
											/*	if(amount.length()==0||Long.parseLong(amount.trim())==0)
												{
														statusStr="Amount must Not Zero";
														System.out.println(statusStr);
														break;
												}
												else*/
												{
													xtw.writeAttribute("Amount",Long.parseLong(amount)+"");
												}
												//xtw.writeAttribute("AccountNo",accountNo);
												System.out.println("chequeNo:"+chequeNo);
												/*if(chequeNo.length()==0||Integer.parseInt(chequeNo.trim())==0)
												{
														statusStr="Cheque must Not Be Zero";
														System.out.println(statusStr);
														break;
												}
												else*/
												{
													xtw.writeAttribute("SerialNo",chequeNo);
												}
												//Above Same As Per CXF
												System.out.println("tranCode:"+tranCode);
												/*if(tranCode.length()==0||Integer.parseInt(tranCode.trim())==0)
												{
														statusStr="Transaction Code must Not Be Zero";
														System.out.println(statusStr);
														break;
												}
												else*/
												{
													xtw.writeAttribute("TransCode",tranCode);
												}
												//MICR Data Ends Here...
												System.out.println("presentingBankRoutNo:"+presentingBankRoutNo);
												/*if(presentingBankRoutNo.length()==0||Integer.parseInt(presentingBankRoutNo.trim())==0)
												{
														statusStr="PresentingBankRoutNo Code must Not Be Zero";
														System.out.println(statusStr);
														break;
												}
												else*/
												{
														xtw.writeAttribute("PresentingBankRoutNo",presentingBankRoutNo);
												}
													System.out.println("cycleNo:"+cycleNo);
													xtw.writeAttribute("PresentmentDate",presentmentDate);
													/*if(cycleNo.length()==0||Integer.parseInt(cycleNo.trim())==0)
													{
															statusStr="CycleNo Code must Not Zero";
															break;
													}
													else
													{*/
																xtw.writeAttribute("CycleNo",cycleNo);
													//}
													System.out.println("clearingType:"+clearingType);
													/*if(clearingType.length()==0||Integer.parseInt(clearingType.trim())==0)
													{
															statusStr="ClearingType Code must Not Be Zero";
															System.out.println(statusStr);
															break;
													}
													else
													{
															xtw.writeAttribute("ClearingType",clearingType);
													}*/

												/*if(retReasonCode.length()==0||Integer.parseInt(retReasonCode.trim())==0)
													{
															statusStr="ReturnReason Code must Not Be Zero";
															System.out.println(statusStr);
															break;
													}
													else*/
													{
															System.out.println("return reason:"+Configuration.lPad(Integer.parseInt(retReasonCode)+"",2,"0"));
															xtw.writeAttribute("ExtensionReason",Configuration.lPad(Integer.parseInt(retReasonCode)+"",2,"0"));
															xtw.writeAttribute("ExtensionPeriod",extensionperiod);

													}


												xtw.writeEndElement();//Item
												psUpdate.setString(1,str_ERF_name);
												psUpdate.setString(2,payorBankRoutNo);
												psUpdate.executeUpdate();
												counter++;
												//NOTE: change the status of ExtensionRequest and clearing inward table(still pending)
										}//2

									xtw.writeStartElement("FileSummary");
									xtw.writeAttribute("TotalItemCount",Integer.toString(totChq));
									xtw.writeAttribute("TotalAmount",Long.toString(totAmt));
									xtw.writeEndElement();//FileSummary
									//System.out.println("** 19 **");
									xtw.writeEndElement();//FileHeader Ends Here
									xtw.writeEndDocument();
									xtw.flush();
									xtw.close();
									fos.flush();
									fos.close();
								}//1.1
								else
								{//1.1
										retVal="\n\t Clearing Inward and Return Outward Cheques Count Not Match.#";
										System.out.println(""+retVal);
								}//1.1
									if(counter==size)
									{//2
										retVal="SUCCESS#";
										PrintWriter pw=new PrintWriter (path_ERF+ERF_done_name);
										pw.flush();
										pw.close();//DSP
										System.out.println("Done..."+retVal);
									}//2
									else if(statusStr.equalsIgnoreCase("PayorBankRoutNo must Not Zero"))
									{//2
											retVal="PayorBankRoutNo must Not be Zero";
											new File(path_ERF+ERF_done_name).delete();
									}//2
									else if(statusStr.equalsIgnoreCase("Amount must Not Zero"))
									{//2
											retVal="Amount must Not be Zero";
											new File(path_ERF+ERF_done_name).delete();
									}//2
									else if(statusStr.equalsIgnoreCase("Cheque must Not Zero"))
									{//2
											retVal="Cheque must Not be Zero";
											new File(path_ERF+ERF_done_name).delete();
									}//2statusStr="Cheque must Not Zero";
									else if(statusStr.equalsIgnoreCase("Transaction Code must Not Zero"))
									{//2
											retVal="Transaction Code must Not be Zero";
											new File(path_ERF+ERF_done_name).delete();
									}//2statusStr="Transaction Code must Not Zero";
									else if(statusStr.equalsIgnoreCase("PresentingBankRoutNo Code must Not Zero"))
									{//2
											retVal="PresentingBankRoutNo Code must Not be Zero";
											new File(path_ERF+ERF_done_name).delete();
									}//2
									else if(statusStr.equalsIgnoreCase("CycleNo Code must Not Zero"))
									{//2
											retVal="CycleNo Code must Not be Zero";
											new File(path_ERF+ERF_done_name).delete();
									}//2
									else if(statusStr.equalsIgnoreCase("ClearingType Code must Not Zero"))
									{//2
											retVal="ClearingType Code must Not be Zero";
											new File(path_ERF+ERF_done_name).delete();
									}//2
									else if(statusStr.equalsIgnoreCase("ReturnReason Code must Not Zero"))
									{//2
											retVal="ReturnReason Code must Not be Zero";
											new File(path_ERF+ERF_done_name).delete();
									}//2
									/*else
									{//2
											retVal="No return outward Cheque#";
											new File(path_ERF+ERF_name).delete();
									}//2*/

							}//1
							else
							{//1
									retVal="No return outward Cheque#";
							}//1
					}//try
					catch (XMLStreamException e)
					{
					  System.out.println("\nXMLStreamException in Engine.generateERF():"+e.getMessage());
					  retVal="FAIL1#";
					}
					catch (IOException ie)
					{
					  System.out.println("\nIOException in Engine.generateERF():"+ie.getMessage());
					  retVal="FAIL2#";
					}
					catch (Exception ie)
					{
						ie.printStackTrace();
					  System.out.println("\nException in Engine.generateERF():"+ie.getMessage());
					  retVal="FAIL3#";
					}
					finally
					{
					  if (xtw != null && rs!=null && psInsert!=null && con!=null && psUpdate!=null)
					  {
						try
						{
							  xtw.close();
							  fos.close();
							  rs.close();
							  psInsert.close();
							  psUpdate.close();
							  psRO.close();
							  //con.close();
						}
						catch (XMLStreamException e)
						{
						  System.out.println("Log4\n"+e.getMessage());
						}
						catch(Exception e)
						{
							}
					  }
					}
					System.out.println("Exit from generateERF ..."+retVal);
					return retVal;
	}//generateERF

	private long getAmount(String str)
	{
			long i=0;
		try
		{
			//System.out.println("Amount ::::"+str);
			String numStr = str;//str.replaceAll("^0*", "");
			long num = Long.parseLong(numStr);
			i= num;
		}
		catch(Exception e)
		{
				System.out.println("Exception in getAmount()"+e);
		}
		return i;
	}
	
}