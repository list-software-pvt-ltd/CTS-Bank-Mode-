								String itemSeqNo=rs.getString(9);//c.ITEMSEQUENCENO
								String payorBankRoutNo=rs.getString(3);//r.RTO_SORTCODE
								String amount=rs.getString(6);//r.AMOUNT
								totAmt += getAmount(amount);
								String accountNo=rs.getString(7);				//Configuration.lPad(rs.getString(6),25,"0");//r.RTO_ACCOUNTNUMBER
								String chequeNo=rs.getString(2);//r.CHEQUENO
								String tranCode=""+Integer.parseInt(rs.getString(5));//r.RTO_TRANSACTIONCODE
								String presentingBankRoutNo=rs.getString(14);//c.PresentingBankRoutNo
								String presentmentDate=rs.getString(11);//c.presentmentDate
								String cycleNo=rs.getString(12);//c.cycleNo
								String clearingType=rs.getString(9);//c.CLEARINGTYPE
								String retReasonCode=Configuration.lPad(""+Integer.parseInt(rs.getString(8)),2,"0");//c.RTO_RETURNREASONCODE
								String BOFDRoutNo=rs.getString(15);//c.BOFDRoutNo
								String BOFDBusDate=rs.getString(16);//c.BOFDBusDate
								String depositorAcct=rs.getString(17);//c.depositorAcct
								if(depositorAcct==null || depositorAcct==" ")
									depositorAcct=" ";
								String ifsc =rs.getString(18);//c.ifsc
								String instrumentId=rs.getString(19);//c.CLI_INSTRUMENT_ID

								singleRecord=payorBankRoutNo+"|"+chequeNo+"|"+amount+"|"+presentmentDate+"|"+Configuration.lPad(Integer.parseInt(retReasonCode)+"",2,"0")+"|"+instrumentId;

								pw1.println(singleRecord);
								pw1.flush();

								//System.out.println("amount:"+amount);

								System.out.println("chequeNo:"+chequeNo);

								System.out.println("tranCode:"+tranCode);
								System.out.println("tranCode:"+payorBankRoutNo);

								//System.out.println("presentingBankRoutNo:"+presentingBankRoutNo);
								//System.out.println("cycleNo:"+cycleNo);
								//System.out.println("clearingType:"+clearingType);
								//System.out.println("return reason:"+Configuration.lPad(Integer.parseInt(retReasonCode)+"",3,"0"));

								//psUpdate.setString(1,str_RET_name);
								psUpdate.setString(1,chequeNo);
								psUpdate.setString(2,payorBankRoutNo);
								psUpdate.setString(3,Configuration.lPad(tranCode,3,"0"));
								psUpdate.setString(4,amount);
								psUpdate.setString(5,clearingType);
								psUpdate.executeUpdate();
								counter++;
							}//2
						pw1.close();
						fos.flush();
						fos.close();
					}//1.1
					else
					{//1.1
						retVal="\n\t Clearing Inward and Return Outward Cheques Count Not Match.#";
						System.out.println(""+retVal);
					}//1.1
					if(counter==size)
					{//2
						retVal="SUCCESS#";
						PrintWriter pw=new PrintWriter (path_ret+RET_done_name);
						pw.flush();
						pw.close();//DSP
						System.out.println("Done..."+retVal);
					}//2
					else if(statusStr.equalsIgnoreCase("PayorBankRoutNo must Not Zero"))
					{//2
						retVal="PayorBankRoutNo must Not be Zero";
						new File(path_ret+RET_done_name).delete();
					}//2
					else if(statusStr.equalsIgnoreCase("Amount must Not Zero"))
					{//2
						retVal="Amount must Not be Zero";
						new File(path_ret+RET_done_name).delete();
					}//2
					else if(statusStr.equalsIgnoreCase("Cheque must Not Zero"))
					{//2
						retVal="Cheque must Not be Zero";
						new File(path_ret+RET_done_name).delete();
					}//2statusStr="Cheque must Not Zero";
					else if(statusStr.equalsIgnoreCase("Transaction Code must Not Zero"))
					{//2
						retVal="Transaction Code must Not be Zero";
						new File(path_ret+RET_done_name).delete();
					}//2statusStr="Transaction Code must Not Zero";
					else if(statusStr.equalsIgnoreCase("PresentingBankRoutNo Code must Not Zero"))
					{//2
						retVal="PresentingBankRoutNo Code must Not be Zero";
						new File(path_ret+RET_done_name).delete();
					}//2
					else if(statusStr.equalsIgnoreCase("CycleNo Code must Not Zero"))
					{//2
						retVal="CycleNo Code must Not be Zero";
						new File(path_ret+RET_done_name).delete();
					}//2
					else if(statusStr.equalsIgnoreCase("ClearingType Code must Not Zero"))
					{//2
						retVal="ClearingType Code must Not be Zero";
						new File(path_ret+RET_done_name).delete();
					}//2
					else if(statusStr.equalsIgnoreCase("ReturnReason Code must Not Zero"))
					{//2
						retVal="ReturnReason Code must Not be Zero";
						new File(path_ret+RET_done_name).delete();
					}//2
				}//1
				else
				{//1
					retVal="No return outward Cheque#";
				}//1
			}//try
			catch (IOException ie)
			{
				System.out.println("\nIOException in Engine.generateRET():"+ie.getMessage());
				retVal="FAIL2#";
			}
			catch (Exception ie)
			{
				ie.printStackTrace();
			  	System.out.println("\nException in Engine.generateRET():"+ie.getMessage());
			  	retVal="FAIL3#";
			}
			finally
			{
				if (rs!=null && psInsert!=null && con!=null && psUpdate==null && pw1!=null)
			  	{
					try
					{
						pw1.close();
						fos.close();
						rs.close();
						psInsert.close();
						psUpdate.close();
						psRO.close();
						//con.close();
					}
					catch(Exception e)
					{
					}
				}
			}
			System.out.println("Exit from generateRET ..."+retVal);
			return retVal;
	}//generateRET
