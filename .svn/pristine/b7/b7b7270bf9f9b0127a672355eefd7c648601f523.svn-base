	public boolean generateCXF(ArrayList<Item> itemAL,String CIBF_fileName)
	{
		//System.out.println("**** inside generateCXF *******");
		//System.out.println("**** itemAL.size() *******"+itemAL.size());
		//this.imgData = imgData;
		versionnumber=Configuration.getConfValByNm("CFG_NPCIVERSIONNO_CLROWD",con);
		boolean flg=false;
		StringBuffer strPk=new StringBuffer();
		fileName = CIBF_fileName.replace("CIBF","CXF");
		fileName=fileName.substring(0,fileName.lastIndexOf("_"))+".XML";
		String fileId=fileName.substring(fileName.lastIndexOf("_")+1,fileName.lastIndexOf("."));
		String[] dateTimeArr=fileName.split("_");
		String creationDate=dateTimeArr[2];
		String creationTime=dateTimeArr[3];
		//System.out.println("creationDate:::"+creationDate);
		//System.out.println("creationTime:::"+creationTime);
		//System.out.println("CXF File ID:::"+fileId);
		//clrType = rec[4];
		String CXF_doneFileName=fileName;
		CXF_doneFileName=CXF_doneFileName.replace("XML","XML.done");
		//System.out.println("CXF_doneFileName:::"+CXF_doneFileName);
		XMLOutputFactory xof = null;
		XMLStreamWriter xtw = null;
		PreparedStatement ps=null;
		FileOutputStream fos=null;
		//Connection con=null;

		try
		{
			xof =  XMLOutputFactory.newInstance();
			String path = Configuration.getConfValByNm("CFG_uploadpath_to_chi",con);
			fos=new FileOutputStream(path+"/"+fileName);
			Writer writer = new OutputStreamWriter(fos, "UTF-8");
			xtw = xof.createXMLStreamWriter(writer);
			

			xtw.writeStartDocument("UTF-8","1.0");
			xtw.writeStartElement("FileHeader");
			xtw.writeAttribute("xmlns","urn:schemas-ncr-com:ECPIX:CXF:FileStructure:"+versionnumber);
			xtw.writeAttribute("VersionNumber", versionnumber);
			xtw.writeAttribute("TestFileIndicator", "P");// it must be P
			xtw.writeAttribute("CreationDate",creationDate);
			xtw.writeAttribute("CreationTime",creationTime);
			xtw.writeAttribute("FileID",fileId);//decide the FileID

			int j=0;
			int totalNoOfItems=0;
			long totalAmount=0;
			//for(ItemInformation itemBean:itemData)
			totalNoOfItems=itemAL.size();
			//System.out.println("itemAL size::"+itemAL.size());
			String allCheque="";
			for(Item item:itemAL)
			{//1
				//System.out.println("\n\titem::"+item);
				ArrayList<ItemInformation> _itemInfoBeanAl=item.getItemInfoBeanAl();//Error at time of kagal
				ArrayList<ImageBean> _imageBeanAl=item.getImageBeanAl();
				ArrayList<MicrDataInformation> _micrBeanAl=item.getMicrBeanAl();
				ArrayList<AddendATag> _addendATagAl=item.getAddendATagAl();
				//System.out.println("\n\n_itemInfoBeanAl size()::"+_itemInfoBeanAl.size());
				//System.out.println("\n\n_micrBeanAl size()::"+_micrBeanAl.size());
				//System.out.println("\n\naddendATagAl size()::"+ _addendATagAl.size());
				//System.out.println("\n\n _imageBeanAl size()::"+ _imageBeanAl.size());

				ItemInformation itemInfo =_itemInfoBeanAl.get(0);
				MicrDataInformation micrBean=_micrBeanAl.get(0);
				AddendATag _addendATag=_addendATagAl.get(0);

				String ourBnkCode=micrBean.getOurBnkCode();
				String chqNo=micrBean.getChqNo();
				String sortCode=micrBean.getSortCode();
				String tranNo=micrBean.getTranNo();
				String amount=micrBean.getAmount();
				String accNo=micrBean.getAccNo();
				String signatureData=micrBean.getSignatureData();
				String signatureLength=micrBean.getSignatureLength();
				String PPRTOFOLLOW=micrBean.getPprToFollow();
				String iqaStatus=micrBean.getIqaStatus();
				String DepositorAcct=micrBean.getDepositorAcct();
				String BOFDBusDate=micrBean.getBOFDBusDate();
				String BOFDRoutNo=micrBean.getBOFDRoutNo();
				String clo_olbc=itemInfo.getClo_Olbc();
				String payeeName= micrBean.getPayeeName();
				payeeName=payeeName.trim();
				String IQAIgnoreInd=micrBean.getIqaignoreind();
				String docType="";

				
				if(PPRTOFOLLOW.equals("N"))
				{
					 docType="B";
					 //IQAIgnoreInd="0";
				}
				else
				{
					docType="C";
					/*if(iqaStatus.equals("FAIL"))
						IQAIgnoreInd="1"; //IQAIgnoreInd :  is optional field
					else
						IQAIgnoreInd="0";*/
				}

				String ifsc=_addendATag.getIFSC();
				//System.out.println("ourBnkCode:::"+ourBnkCode);
				System.out.println("chqNo:::"+chqNo);
				//System.out.println("sortCode:::"+sortCode);
				//System.out.println("tranNo:::"+tranNo);
				//System.out.println("amount:::"+amount);
				//System.out.println("accNo:::"+accNo);
				//System.out.println("signatureLength:::"+signatureLength);
				//System.out.println("_imageBeanAl size:::"+_imageBeanAl.size());

				totalAmount += getAmount(amount);
				String MICRFingerPrint=chqNo+";"+sortCode+";"+accNo+";"+tranNo+";"+amount+";";
				String itemSeqNo=itemInfo.getItemSeqNumber();
				strPk.append(chqNo+"#"+sortCode+"#"+tranNo+"#"+amount+"#"+accNo+"#"+itemSeqNo+"!@!");
				xtw.writeStartElement("Item");
				xtw.writeAttribute("ItemSeqNo",itemSeqNo);
				//MICR Data					SerialNo;PayorBankRoutNo;TransCode;Amount
				xtw.writeAttribute("PayorBankRoutNo",sortCode);//chqNo+sortCode+tranNo+amount
				xtw.writeAttribute("Amount",Long.parseLong(amount)+"");
				if(accNo.length()>0)
					xtw.writeAttribute("AccountNo",accNo);
				xtw.writeAttribute("SerialNo",chqNo);
				xtw.writeAttribute("TransCode",tranNo);
				//MICR Data Ends Here...
				xtw.writeAttribute("PresentingBankRoutNo",ourBnkCode);
				xtw.writeAttribute("PresentmentDate",Configuration.getDDMMYYYY());//cheque scanning date
				xtw.writeAttribute("CycleNo","01");//default is 1
				xtw.writeAttribute("NumOfImageViews","3");
				xtw.writeAttribute("ClearingType",itemInfo.getClearingType());//02 means LOCAL HIGH VALUE CHEQUES
				xtw.writeAttribute("DocType",docType);
				xtw.writeAttribute("MICRRepairFlags","000000");//default 000000
				xtw.writeAttribute("UserField",payeeName); // ----- optional ...
				/*if(IQAIgnoreInd.equalsIgnoreCase("Y"))
				{
					//IQAIgnoreInd="1";
					xtw.writeAttribute("IQAIgnoreInd","1");
				}*/
				

				//this value we can get from .txt file given by custodian
				xtw.writeStartElement("AddendA");
				xtw.writeAttribute("BOFDRoutNo",BOFDRoutNo);
				xtw.writeAttribute("BOFDBusDate",BOFDBusDate);
				xtw.writeAttribute("IFSC",ifsc);
				xtw.writeEndElement();//AddendA

				xtw.writeStartElement("MICRDS");
				xtw.writeAttribute("Source","Capture");
				xtw.writeAttribute("DigitalSignatureMethod",digitalsignaturemethod);
				xtw.writeAttribute("SecurityKeySize",securitykeysize);
				xtw.writeAttribute("MICRFingerPrint",MICRFingerPrint);
				xtw.writeAttribute("DigitalSignatureLength","344");//signatureLength
				xtw.writeAttribute("SignatureData",signatureData);
				xtw.writeAttribute("SecurityOriginatorName",securityoriginatorname.length()<16?securityoriginatorname:securityoriginatorname.substring(0,16));
				xtw.writeAttribute("SecurityAuthenticatorName",securityauthenticatorname.length()<16?securityauthenticatorname:securityauthenticatorname.substring(0,16));
				xtw.writeAttribute("SecurityKeyName",securitykeyname.length()<16?securitykeyname:securitykeyname.substring(0,16));
				xtw.writeEndElement();//MICRDS
				//System.out.println("\n\n\n1");

				for(ImageBean  imageBean:_imageBeanAl)
				{//2
					//System.out.println("**** inside ImageBean *****");

					xtw.writeStartElement("ImageViewDetail");
					xtw.writeAttribute("ViewFormat",imageBean.getViewFormat());
					xtw.writeAttribute("CompressionType",imageBean.getImageCompressionType());// default none is allow
					xtw.writeAttribute("ViewSideIndicator",imageBean.getViewSideIndicator());
					xtw.writeAttribute("ViewDescriptor","Full");//default 'Full'
					xtw.writeAttribute("ImageAvailable","Y");//default is Y
					xtw.writeStartElement("ImageViewData");
					xtw.writeAttribute("ImageDataLength",imageBean.getImageDataLength());
					xtw.writeAttribute("ImageDataOffset",imageBean.getImageDataOffset());
					xtw.writeAttribute("FileName",imageBean.getFileName());
					xtw.writeAttribute("ClippingOrigin","0");//0 indicate Full image so don't  change it
					xtw.writeEndElement();//ImageViewData

					xtw.writeStartElement("ImageDS");
					xtw.writeAttribute("Source","Capture");
					xtw.writeAttribute("DigitalSignatureMethod",digitalsignaturemethod);
					xtw.writeAttribute("SecurityKeySize",imageBean.getSecurityKeySize());
					xtw.writeAttribute("StartOfProtectedData",imageBean.getImageDataOffset());
					xtw.writeAttribute("ProtectedDataLength",imageBean.getImageDataLength());
					xtw.writeAttribute("DigitalSignatureDataOffset",imageBean.getDigitalSignatureDataOffset());
					xtw.writeAttribute("DigitalSignatureLength",imageBean.getDigitalSignatureLength());
					xtw.writeAttribute("FileName",imageBean.getFileName());
					xtw.writeAttribute("SecurityOriginatorName",securityoriginatorname.length()<16?securityoriginatorname:securityoriginatorname.substring(0,16));
					xtw.writeAttribute("SecurityAuthenticatorName",securityauthenticatorname.length()<16?securityauthenticatorname:securityauthenticatorname.substring(0,16));
					xtw.writeAttribute("SecurityKeyName",securitykeyname.length()<16?securitykeyname:securitykeyname.substring(0,16));
					xtw.writeEndElement();//ImageDS
					xtw.writeStartElement("ImageViewAnalysis");
					xtw.writeAttribute("Source","Capture");
					xtw.writeAttribute("ImageQuality","0");
					xtw.writeAttribute("ImageUsability","0");//0 b'coz image is not tested
					xtw.writeAttribute("ImagingBankSpecificTest","0");
					xtw.writeEndElement();//ImageViewAnalysis
					xtw.writeEndElement();//ImageViewDetail
				}//2
				//System.out.println(":::::::::");
				//System.out.println(":::::::::");
				//System.out.println(":::::::::");
				xtw.writeEndElement();//Item
			}//1
			//System.out.println("\n\n\n2");
			xtw.writeStartElement("FileSummary");
			String totnoOfItem=Integer.toString(totalNoOfItems);
			String totAmt=Long.toString(totalAmount);
			xtw.writeAttribute("TotalItemCount",totnoOfItem);
			xtw.writeAttribute("TotalAmount",totAmt);// here sum of amount fileds of Item tag
			xtw.writeEndElement();//FileSummary
			xtw.writeEndElement();//FileHeader Ends Here
			xtw.writeEndDocument();
			xtw.flush();
			xtw.close();
			fos.flush();
			fos.close();
			if(!flg)
			{
				//create .done file
				String CIBF_DonefileName=CIBF_fileName;
				CIBF_DonefileName=CIBF_DonefileName.replace("img","img.done");
				//System.out.println("CIBF_DonefileName::>>"+CIBF_DonefileName);
				//path+"/"+fileName
				PrintWriter pw=new PrintWriter(path+"/"+CXF_doneFileName);
				pw.flush();
				pw.close();
				PrintWriter pw2=new PrintWriter(path+"/"+CIBF_DonefileName);
				pw2.flush();
				pw2.close();
				String scannerStr=Configuration.getConfValByNm("CFG_SCANNER",con);
				//con=Configuration.getConnection();
				String sql="update CLEARINGOUTWARD set CLO_CONVERT_FLG='D'";
				sql+=" ,CLO_XMLFILENAME=?";
				//sql+=" ,CLO_ITEMSEQNO=?";
				sql+=" WHERE CLO_ITEMSEQNO=?";
				//sql+=" AND CLO_SORTCD=?";
				//sql+=" AND CLO_TRANCD=?";
				//sql+=" AND CLO_AMOUNT=?";
				sql+=" AND CLO_DATE_DDMMYYYY=?";
				//if(scannerStr.equalsIgnoreCase("PANINI"))
				//	sql+=" AND CLO_DRAWEE_ACCNO=?";
				sql+=" AND CLO_CONVERT_FLG='Y'";
				ps=con.prepareStatement(sql);

				//update all records
				String[] allItems=strPk.toString().split("!@!");
				//System.out.println("\n\n\tallItems="+allItems.length);
				for(int i=0;i<allItems.length;i++)
				{
					//System.out.println("\n\n\t in loop of update:::::>>>"+i);
					System.out.println("\n\n\t allItems[i]:::::>>>"+allItems[i]);
					String[] singleItem=allItems[i].split("#");
					String CLO_CHQNO=singleItem[0];
					String CLO_SORTCD=singleItem[1];
					String CLO_TRANCD=singleItem[2];
					String CLO_AMOUNT=singleItem[3];
					String CLO_DRAWEE_ACCNO=singleItem[4];
					String itemSeqNo=singleItem[5];

					System.out.println("\n\t CLO_CHQNO:"+CLO_CHQNO);
					System.out.println("\n\t CLO_SORTCD:"+CLO_SORTCD);
					System.out.println("\n\t CLO_TRANCD:"+CLO_TRANCD);
					System.out.println("\n\t CLO_AMOUNT:"+CLO_AMOUNT);
					System.out.println("\n\t CLO_DRAWEE_ACCNO:"+CLO_DRAWEE_ACCNO);
					System.out.println("\n\t itemSeqNo:"+itemSeqNo);

					ps.setString(1,fileName);
					ps.setString(2,itemSeqNo);
					//ps.setString(2,CLO_CHQNO);
					//ps.setString(3,CLO_SORTCD);
					//ps.setString(4,CLO_TRANCD);
					//ps.setString(5,CLO_AMOUNT);
					ps.setString(3,Configuration.getDDMMYYYY());
					//if(scannerStr.equalsIgnoreCase("PANINI"))
					//	ps.setString(7,CLO_DRAWEE_ACCNO);
					if(ps.executeUpdate()==1)
					{
						System.out.println("\n\t Record Updated..");
					}
					else
					{
						System.out.println("\n\t Multiple Recourds Found..");
					}
				}
			}
			//System.out.println("**** EXIT from  generateCXF *******");
		}
		catch (XMLStreamException e)
		{
			System.out.println("XMLStreamException in Engine generateCXF()\n"+e.getMessage());
			flg=true;
		}
		catch(SQLException e)
		{
			System.out.println("SQLException in Engine generateCXF()\n"+e.getMessage());
		  	flg=true;
		}
		catch (IOException ie)
		{
			System.out.println("IOException in Engine generateCXF()\n"+ie.getMessage());
			flg=true;
		}
		catch (Exception ie)
		{
			System.out.println("Exception in Engine generateCXF()\n"+ie.getMessage());
			ie.printStackTrace();
			flg=true;
		}
		finally
		{
		if (xtw != null && ps!=null && con!=null)
		{
			try
			{
				ps.close();
				//con.close();
				xtw.close();
				fos.close();
			}
			catch(SQLException e)
			{
				System.out.println("\n\tSQLException"+e.getMessage());
			}
			catch (XMLStreamException e)
			{
				System.out.println("Log4\n"+e.getMessage());
			} 
			catch (IOException e) {
				System.out.println("\nIOException"+e.getMessage());
			}
		}
	}
	return flg;
}//end generateCXF

	//GenerateSBS_HDFC
	public boolean generateSBS_HDFC(ArrayList<Item> itemAL,String CIBF_fileName)
	{
		System.out.println("**** inside GenerateSBS_HDFC---- *******");
		System.out.println("**** itemAL.size() *******"+itemAL.size());

		boolean flg=false;
		StringBuffer strPk=new StringBuffer();
		fileName = CIBF_fileName.replace("SBI","SBS");
		fileName=fileName.substring(0,fileName.lastIndexOf("."))+".XML";
		String fileId=CIBF_fileName.substring(CIBF_fileName.lastIndexOf("_")+1,CIBF_fileName.lastIndexOf("."));
		String[] dateTimeArr=CIBF_fileName.split("_");
		String creationDate=dateTimeArr[3];
		String creationTime=dateTimeArr[4];
		System.out.println("creationDate:::"+creationDate);
		System.out.println("creationTime:::"+creationTime);
		System.out.println("SBS File ID:::"+fileId);
		String vendorId,vendorName,hubLocationId,hubLocationName;
		
		/*String SBS_doneFileName=fileName;
		SBS_doneFileName=SBS_doneFileName.replace("XML","XML.done");
		System.out.println("SBS_doneFileName:::"+SBS_doneFileName);*/
		XMLOutputFactory xof = null;
		XMLStreamWriter xtw = null;
		PreparedStatement ps=null;
		//Connection con=null;
		FileOutputStream fos=null;

		try
		{
			xof =  XMLOutputFactory.newInstance();
			String path = Configuration.getConfValByNm("CFG_uploadpath_to_chi",con);
			fos=new FileOutputStream(path+"/"+fileName);
			Writer writer = new OutputStreamWriter(fos, "UTF-8");
			xtw = xof.createXMLStreamWriter(writer);
			vendorId=Configuration.getConfValByNm("CFG_VENDOR_ID",con);
			hubLocationId=Configuration.getConfValByNm("CFG_HUB_LOCATION_ID",con);
			vendorName=Configuration.getConfValByNm("CFG_VENDOR_NAME",con);
			hubLocationName=Configuration.getConfValByNm("CFG_HUB_LOCATION_NAME",con);
			//OlbcNo=Configuration.getConfValByNm("CLO_OLBC");
			//System.out.println("\n\n olbc****"+OlbcNo);


			xtw.writeStartDocument("UTF-8","1.0");
			xtw.writeStartElement("FileHeader");
			xtw.writeAttribute("VendorId",vendorId);//CFG_VENDOR_ID=00875
			xtw.writeAttribute("VendorName",vendorName);//VendorName=GKFS
			xtw.writeAttribute("HubLocationId",hubLocationId);//HubLocationId=002
			xtw.writeAttribute("HubLocationName",hubLocationName);//HubLocationName= New Delhi
			//xtw.writeAttribute("TestFileIndicator", "P");// it must be P
			xtw.writeAttribute("FileCreationDate",creationDate);
			xtw.writeAttribute("FileCreationTime",creationTime);
			xtw.writeAttribute("FileId",fileId);//decide the FileID
			xtw.writeAttribute("CoreSystem",Configuration.getConfValByNm("CFG_CORE_SYSTEM",con));//coreSystem=CMS

			int k;
			int totalNoOfItems=0;
			long totalAmount=0;
			totalNoOfItems=itemAL.size();
			System.out.println("itemAL size::"+itemAL.size());
			//String allCheque="";
			for(Item item:itemAL)
			{//1
				System.out.println("\n\titem::"+item);
				ArrayList<ItemInformation> _itemInfoBeanAl=item.getItemInfoBeanAl();
				ArrayList<ImageBean> _imageBeanAl=item.getImageBeanAl();
				ArrayList<MicrDataInformation> _micrBeanAl=item.getMicrBeanAl();
				ArrayList<AddendATag> _addendATagAl=item.getAddendATagAl();
				System.out.println("\n\n_itemInfoBeanAl size()::"+_itemInfoBeanAl.size());
				System.out.println("\n\n_micrBeanAl size()::"+_micrBeanAl.size());
				System.out.println("\n\n addendATagAl size()::"+ _addendATagAl.size());
				System.out.println("\n\n _imageBeanAl size()::"+ _imageBeanAl.size());

				ItemInformation itemInfo =_itemInfoBeanAl.get(0);
				MicrDataInformation micrBean=_micrBeanAl.get(0);
				AddendATag _addendATag=_addendATagAl.get(0);

				String ourBnkCode=Configuration.getConfValByNm("CFG_BANKROUTINGCODE",con);
				String chqNo=micrBean.getChqNo();
				String sortCode=micrBean.getSortCode();
				String tranNo=micrBean.getTranNo();
				String amount=micrBean.getAmount();
				String accNo=micrBean.getAccNo();
				//accNo=accNo.substring(accNo.length()-7, accNo.length());//sam
				//String signatureData=micrBean.getSignatureData();
				String signatureLength=micrBean.getSignatureLength();
				String PPRTOFOLLOW=micrBean.getPprToFollow();
				//String iqaStatus=micrBean.getIqaStatus();
				String DepositorAcct=micrBean.getDepositorAcct();
				//String BOFDBusDate=micrBean.getBOFDBusDate();
				String BOFDRoutNo=micrBean.getBOFDRoutNo();
				String clo_olbc=itemInfo.getClo_Olbc();
				String payeeName= micrBean.getPayeeName();
				System.out.println("\n\nPayeeName="+payeeName+"\n\n");
				String docType="";
				//String ImageIQAFlags="";
				//String ImageUAFlags="";
				//String newbritemSeqNo="";
				//String itemSeqNo=itemInfo.getItemSeqNumber();

				
				  //String IQAIgnoreInd=""; 
				  if(PPRTOFOLLOW.equals("N")) 
				  {
					  docType="B";
					  //IQAIgnoreInd="0";
				  } 
				  else 
				  { 
					  docType="C"; 
				  }
					/* if(iqaStatus.equals("FAIL"))IQAIgnoreInd="1"; */ //IQAIgnoreInd : is optional field else IQAIgnoreInd="0"; }
				 
				String ifsc=_addendATag.getIFSC();
				System.out.println("ourBnkCode:::"+ourBnkCode);
				System.out.println("chqNo:::"+chqNo);
				System.out.println("sortCode:::"+sortCode);
				System.out.println("tranNo:::"+tranNo);
				System.out.println("amount:::"+amount);
				System.out.println("accNo:::"+accNo);

				System.out.println("signatureLength:::"+signatureLength);
				System.out.println("_imageBeanAl size:::"+_imageBeanAl.size());
				totalAmount += getAmount(amount);
				//String MICRFingerPrint=chqNo+";"+sortCode+";"+tranNo+";"+amount+";";//sam
			
				vendorId=Configuration.lPad(""+Integer.parseInt(vendorId),5,"0");
				clo_olbc=clo_olbc.substring(clo_olbc.length()-6, clo_olbc.length());
				String itemSeqNo=itemInfo.getItemSeqNumber();
				//String branchcd=itemInfo.getBranchCode();
				
				//String britemSeqNo=itemSeqNo.substring(itemSeqNo.length()>=6?(itemSeqNo.length()-5):0, itemSeqNo.length());
				String newitemSeqNo=vendorId+hubLocationId;//+brStr;//newbritemSeqNo;
				String brStr=Configuration.lPad(""+(++counter),(14-newitemSeqNo.length()),"0");//Configuration.lPad(""+(Long.parseLong(branchcd)*100),4,"0");
				newitemSeqNo=newitemSeqNo+brStr;
				/*
				 * if(branchcd.length()<2)
				 * newbritemSeqNo=Long.parseLong(britemSeqNo)+((Long.parseLong(branchcd)*100000)
				 * ); else
				 */
				
				//newbritemSeqNo=Long.parseLong(britemSeqNo)+brStr;//((Long.parseLong(branchcd)*10000));
				
				//System.out.println("\n newbritemSeqNo======"+newbritemSeqNo+"\n\n");
				
				System.out.println("\n newitemSeqNo="+newitemSeqNo+"\n\n");
				
				strPk.append(chqNo+"~"+sortCode+"~"+tranNo+"~"+amount+"~"+accNo+"~"+itemSeqNo+"~"+newitemSeqNo+"!@!");
				xtw.writeStartElement("Item");
				xtw.writeAttribute("ItemSeqNo",newitemSeqNo);
				xtw.writeAttribute("PayorBankRoutNo",sortCode);
				xtw.writeAttribute("Amount",Long.parseLong(amount)+"");
				xtw.writeAttribute("AccountNo",accNo);
				xtw.writeAttribute("SerialNo",chqNo);
				xtw.writeAttribute("TransCode",tranNo);
				xtw.writeAttribute("PresentmentDate",Configuration.getDDMMYYYY());//cheque scanning date
				xtw.writeAttribute("ClearingType",itemInfo.getClearingType());//02 means LOCAL HIGH VALUE CHEQUES
				xtw.writeAttribute("DocType",docType);
				xtw.writeAttribute("MICRRepairFlag","000000");//default 000000
				xtw.writeAttribute("TruncatingRoutNo",ourBnkCode);// ----- optional ...

				String tempPayeeNm=payeeName;
				payeeName="";
				for(int z=0;z<tempPayeeNm.length();z++)
				{
					int ascii=tempPayeeNm.charAt(z);
					if((ascii>=65 && ascii<=90) || (ascii>=97 && ascii<=122))
						payeeName=payeeName+(char)ascii;
				}
				xtw.writeAttribute("UserField",payeeName); // ----- optional ...
				xtw.writeAttribute("ImageQuality","2");//0 b'coz image is not tested
				xtw.writeAttribute("ImageUsability","0");//0 b'coz image is not tested
				xtw.writeAttribute("ImageIQAFlags","2222222222222222");
				xtw.writeAttribute("ImageUAFlags","00000000000000");
				xtw.writeAttribute("BOFDRoutNo",BOFDRoutNo);
				xtw.writeAttribute("BOFDBusDate",Configuration.getDDMMYYYY());
				xtw.writeAttribute("DepositorAcct",DepositorAcct);//**** ----- optional ...
				xtw.writeAttribute("IFSC",ifsc);
				xtw.writeAttribute("ImageBinaryFileName",CIBF_fileName);
				k=1;
				for(ImageBean  imageBean:_imageBeanAl)
				{//2
					System.out.println("**** inside ImageBean *****");

					xtw.writeAttribute("ImageDetails"+k+"-ViewSideIndicator",imageBean.getViewSideIndicator());
					xtw.writeAttribute("ImageDetails"+k+"-ImageDataOffset",imageBean.getImageDataOffset());
					xtw.writeAttribute("ImageDetails"+k+"-ImageDataLength",imageBean.getImageDataLength());
					k++;
				}//2
				System.out.println(":::::::::");
				System.out.println(":::::::::");
				System.out.println(":::::::::");
				xtw.writeEndElement();//Item
			}//1
			System.out.println("\n\n\n2");
			xtw.writeStartElement("FILEFOOTER");
			String totnoOfItem=Integer.toString(totalNoOfItems);
			String totAmt=Long.toString(totalAmount);
			xtw.writeAttribute("TotalItemCount",totnoOfItem);
			xtw.writeAttribute("TotalAmount",totAmt);// here sum of amount fileds of Item tag
			xtw.writeEndElement();//FILEFOOTER

			xtw.writeEndElement();//FileHeader Ends Here
			xtw.writeEndDocument();

			xtw.flush();
			xtw.close();
			fos.flush();
			fos.close();
			if(!flg)
			{
			/*	String CIBF_DonefileName=CIBF_fileName;
				CIBF_DonefileName=CIBF_DonefileName.replace("img","img.done");
				System.out.println("CIBF_DonefileName::>>"+CIBF_DonefileName);
				PrintWriter pw=new PrintWriter(path+"/"+SBS_doneFileName);
				pw.flush();
				pw.close();
				PrintWriter pw2=new PrintWriter(path+"/"+CIBF_DonefileName);
				pw2.flush();
				pw2.close();*/

				//con=Configuration.getConnection();
				String sql="update CLEARINGOUTWARD set CLO_CONVERT_FLG='D',";
				sql+=" CLO_XMLFILENAME=?,";
				sql+=" CLO_ITEMSEQNO=?";
				sql+=" WHERE CLO_ITEMSEQNO=?";
				sql+=" AND CLO_DATE_DDMMYYYY=?";
				sql+=" AND CLO_CONVERT_FLG='Y'";

				ps=con.prepareStatement(sql);
				String[] allItems=strPk.toString().split("!@!");
				System.out.println("\n\n\tallItems="+allItems.length);
				for(int i=0;i<allItems.length;i++)
				{
					System.out.println("\n\n\t in loop of update:::::>>>"+i);
					System.out.println("\n\n\t allItems[i]:::::>>>"+allItems[i]);
					String[] singleItem=allItems[i].split("~");
					/*
					 * String CLO_CHQNO=singleItem[0]; String CLO_SORTCD=singleItem[1]; String
					 * CLO_TRANCD=singleItem[2]; String CLO_AMOUNT=singleItem[3]; String
					 * CLO_DRAWEE_ACCNO=singleItem[4];
					 */
					String itemSeqNo=singleItem[5];
					String newitemSeqNo=singleItem[6];

					
					//System.out.println("\n\t CLO_SORTCD:"+CLO_SORTCD);
					//System.out.println("\n\t CLO_TRANCD:"+CLO_TRANCD);
					//System.out.println("\n\t CLO_AMOUNT:"+CLO_AMOUNT);
					//System.out.println("\n\t CLO_DRAWEE_ACCNO:"+CLO_DRAWEE_ACCNO);
					System.out.println("\n\t itemSeqNo:"+itemSeqNo);
					System.out.println("\n\t newitemSeqNo:"+newitemSeqNo);

					ps.setString(1,fileName);
					ps.setString(2,newitemSeqNo);
					ps.setString(3,itemSeqNo);
					ps.setString(4,Configuration.getDDMMYYYY());
					
					if(ps.executeUpdate()>0)
					{
						System.out.println("\n\t Record Updated..");
					}
				}
			}
			System.out.println("**** EXIT from  generateSBS_HDFC *******");
		}
		catch (XMLStreamException e)
		{
		  System.out.println("XMLStreamException in Engine generateSBS()\n"+e.getMessage());
		  flg=true;
		}
		catch(SQLException e)
		{
			System.out.println("SQLException in Engine generateSBS()\n"+e.getMessage());
		  	flg=true;
		}
		catch (IOException ie)
		{
		  System.out.println("IOException in Engine generateSBS()\n"+ie.getMessage());
		  flg=true;
		}
		catch (Exception ie)
		{
			System.out.println("Exception in Engine generateSBS()\n"+ie.getMessage());
			ie.printStackTrace();
			 flg=true;
		}
		finally
		{
		  if (xtw != null && ps!=null && con!=null)
		  {
		    try
		    {
					ps.close();
					//con.close();
		      		xtw.close();
		      		fos.close();
		    }
		    catch(SQLException e)
		    {
				System.out.println("\n\tSQLException"+e.getMessage());
			}
		    catch (XMLStreamException e)
		    {
		      System.out.println("Log4\n"+e.getMessage());
		    } 
		    catch (IOException e) {
		    	System.out.println("\nIOException"+e.getMessage());
			}
		  }
		}
		return flg;
	}//end GenerateSBS_HDFC

	public static boolean fetchextensionoutward(String clearingtype,String extensionperiod,String extensionreasoncode)
	{//1
                System.out.println("\n\t inside Engine.fetchextensionoutward() ====="+clearingtype);
				boolean flg=false;
				PreparedStatement psInsert=null,psselect=null;
				Connection con=null;
				System.out.println("clearingtype::"+clearingtype);
				 System.out.println("extensionperiod::"+extensionperiod);
				 	 System.out.println("extensionreasoncode::"+extensionreasoncode);
		try
		{
         con=Configuration.getConnection();
		 String todaydate=Configuration.getDDMMYYYY();
		 String todaytime=Configuration.getHHMISS();
		 psselect=con.prepareStatement("select  cli_itemsequenceno,cli_payorbankroutno,cli_amount,cli_accountno,cli_serialno,cli_transcode,cli_presentingbankroutno,cli_presentmentdate,cli_cycleno,cli_creationdate,cli_xmlfilename from clearinginward where cli_clearingtype=? and cli_ddmmyyyy=?");
		 psselect.setString(1,clearingtype);
		 psselect.setString(2,todaydate);
		 String insqry="insert into extension_outward(ext_itemseqno, ext_payorbankroutno, ext_amount, ext_accountno, ext_serialno,ext_transcode, ext_presentingbankroutno, ext_presentmentdate, ext_cycleno,ext_creationdate,ext_filename,ext_creationtime,  ext_ddmmyyyy, ext_status, ext_filetype, ext_wrn_code,ext_extensionperiod,ext_extensionreasoncode,ext_clearingtype) values(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)";
		 ResultSet rs=psselect.executeQuery();
                  while(rs.next())
				  {   psInsert=con.prepareStatement(insqry);
						 String S1=rs.getString(1);
						 String S2=rs.getString(2);
						 String S3=rs.getString(3);
						 String S4=rs.getString(4);
						 String S5=rs.getString(5);
						 String S6=rs.getString(6);
						 String S7=rs.getString(7);
						 String S8=rs.getString(8);
						 String S9=rs.getString(9);
						 String S10=rs.getString(10);
						 String S11=rs.getString(11);

						 String S12=Configuration.getDDMMYYYY();
						// System.out.println(rs.getString(1)+"cli_accountno "+rs.getString(2));
						// System.out.println(rs.getString(3)+"cli_transcode "+rs.getString(4));
						// System.out.println(rs.getString(5)+"cli_presentingbankroutno "+rs.getString(6));
						// System.out.println(rs.getString(7)+"cli_cycleno "+rs.getString(8));
						// System.out.println(extensionperiod+"extensionperiod "+extensionreasoncode);
						// System.out.println(Configuration.getDDMMYYYY()+"Configuration.getDDMMYYYY() "+extensionreasoncode);
						        psInsert.setString(1,S1);
								psInsert.setString(2,S2);
								psInsert.setString(3,S3);
								psInsert.setString(4,S4);
								psInsert.setString(5,S5);
								psInsert.setString(6,S6);
								psInsert.setString(7,S7);
								psInsert.setString(8,S8);
								psInsert.setString(9,S9);
								psInsert.setString(10,S10);
								psInsert.setString(11,S11);
								psInsert.setString(12,"");
								psInsert.setString(13,S12);
								psInsert.setString(14,"Y");
								psInsert.setString(15,"");
								psInsert.setString(16,"");
								psInsert.setString(17,extensionperiod);
								psInsert.setString(18,extensionreasoncode);
								psInsert.setString(19,clearingtype);

							   int i= psInsert.executeUpdate();
							   System.out.println(i+" records inserted");


                   }



		 }
		 catch(SQLException e)
		{
				System.out.println("\n\tSQLException in Engine.fetchextensionoutward()"+e);
				err_status="Problem at inserting record to Returnoutward Table.";
		}
		catch(Exception e)
