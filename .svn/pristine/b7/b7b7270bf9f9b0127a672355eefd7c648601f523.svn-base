					{
							try
							{
								psInsert.close();
								psselect.close();
								con.close();
							}catch(SQLException e){}
					}
		}

		//return flg;
		return true;


}

	public static boolean readAndInsertRetunOutwardTextFile()
	{
			System.out.println("\n\t inside Engine.readAndInsertRetunOutwardTextFile() =====");
			boolean flg=false;
			PreparedStatement psInsert=null;
			Connection con=null;
			int recCount=0;
			try
			{
					String rec = "";
					con=Configuration.getConnection();
					double newver=2.1;
					String OURVERSIONNO=Configuration.getConfValByNm("CFG_OURVERSIONNO",con);
					System.out.print("OURVERSIONNO=====" + OURVERSIONNO);
					String path=Configuration.getConfValByNm("CFG_uploadpath_to_chi",con)+"ReturnOutward/";;
					String BOFD ="";
					String chequeNo ="";
					String sortCode ="";
					String tranCode ="";
					String amount ="";
					String accountNo ="";
					String retReasonCode ="";
					String payorbankroutNo="";
					String seq_uniqueNo="";
					String clearingType="";
					String returnReasonCommt=" ";
					String itemsequenceNo="";
					
					//File cbsFile=new File(path+"From_CBS_Return_Outward.txt"));
					//psInsert=con.prepareStatement("Insert into RETRUNOUTWARD values(?,?,?,?,?,?,?,?,?,?,?)");
					psInsert=con.prepareStatement("Insert into RETRUNOUTWARD(RTO_BOFD,RTO_CHEQUENO,RTO_SORTCODE,RTO_TRANSACTIONCODE,RTO_AMOUNT,RTO_ACCOUNTNUMBER,RTO_RETURNREASONCODE,RTO_STATUS,RTO_PAYORBANKROUTNO,RTO_DDMMYYYY,RTO_CLEARINGTYPE,RTO_RETREASONCOMMT,RTO_ITEMSEQUENCENO) values(?,?,?,?,?,?,?,?,?,?,?,?,?)");
					File retOwdFile=new File(path+"From_CBS_Return_Outward.txt");
					BufferedReader br = new BufferedReader(new FileReader(retOwdFile));

					while ((rec = br.readLine()) != null)
					{//1
								recCount++;
								BOFD =rec.substring(0,9);
								chequeNo =rec.substring(9,15);
								sortCode = rec.substring(15,24);
								
								tranCode = Configuration.lPad("" + Integer.parseInt(rec.substring(24,27)),3,"0");//""+Integer.parseInt(rec.substring(24,27));
								
								 amount = rec.substring(27,45);//Amount
									accountNo = rec.substring(45,60);//Account No
									//accountNo = rec.substring(61,70);//Account No
									retReasonCode = Configuration.lPad(""+Integer.parseInt(rec.substring(60,62)),2,"0");//Ret Reason Code NOTE: 3 digits provided from CBS
									//payorbankroutNo= sortCode;//rec.substring(62,71);this change is done in CBS...
									payorbankroutNo=rec.substring(62,71);
									//seq_uniqueNo=rec.substring(62,77);//unique no 15 digits
									clearingType=rec.substring(71,73);
								if(Double.parseDouble(OURVERSIONNO)>=newver)
								{
								itemsequenceNo=rec.substring(73,93);
								}
								else{
									itemsequenceNo="";
								}
								if(returnReasonCommt.length()==0)
								{
									returnReasonCommt="  ";
								}
								
								
								psInsert.setString(1,BOFD);
								psInsert.setString(2,chequeNo);
								psInsert.setString(3,sortCode);
								psInsert.setString(4,tranCode);
								 System.out.println("amount=====insetr" + amount);
								psInsert.setString(5,amount);
								psInsert.setString(6,accountNo);
								psInsert.setString(7,retReasonCode);
								psInsert.setString(8,"Y");
								psInsert.setString(9,payorbankroutNo);
								//psInsert.setString(10,seq_uniqueNo);//RTO_UNIQUENO
								psInsert.setString(10,Configuration.getDDMMYYYY());//RTO_DDMMYYYY chage it's index to 11
								psInsert.setString(11,clearingType);
								psInsert.setString(12,returnReasonCommt);
								psInsert.setString(13,itemsequenceNo.replaceAll("\\s",""));

								try
								{
									int result=psInsert.executeUpdate();
										if(result>0)
											System.out.println("record is inserted..");
								}
								catch(SQLException e)
								{
										e.printStackTrace();
										if(!(e.getMessage().indexOf("ORA-00001")>-1))
										{
											throw new Exception("Exception in Engine.readAndInsertRetunOutwardTextFile()");
										}
								}

					}//1
					br.close();
					retOwdFile.delete();
					/*if(recCount==0)
					{
						err_status="No record present in From_Cbs_Return_Outward.txt";
					}
					else
					{
						flg=true;
					}*/
					/*if(recCount>0)
					{
							//err_status="No record present in From_Cbs_Return_Outward.txt";
							new File(path+"From_CBS_Return_Outward.txt").delete();
					}*/
		}
		catch(FileNotFoundException e)
		{		e.printStackTrace();
				System.out.println("\n\tFileNotFoundException in Engine.readAndInsertRetunOutwardTextFile()"+e);
				if(e.getMessage().contains("FileNotFoundException"))
				{
					err_status="From_Cbs_Return_Outward.txt is file not available on upload path.";
				}
				if(recCount==0)
				{
					err_status="No record present in From_Cbs_Return_Outward.txt.";
				}
		}
		catch(StringIndexOutOfBoundsException e)
		{			e.printStackTrace();
					System.out.println("\n\tStringIndexOutOfBound in Engine.readAndInsertRetunOutwardTextFile()"+e);
					err_status="From_Cbs_Return_Outward.txt file is Not in Proper format.";
		}
		catch(SQLException e)
		{		e.printStackTrace();
				System.out.println("\n\tSQLException in Engine.readAndInsertRetunOutwardTextFile()"+e);
				err_status="Problem at inserting record to Returnoutward Table.";
		}
		catch(Exception e)
		{		e.printStackTrace();
				System.out.println("\n\tException in Engine.readAndInsertRetunOutwardTextFile()"+e);
				err_status="Fail";
		}
		finally
		{
				if(psInsert!=null && con!=null)
					{
							try
							{
								psInsert.close();
								con.close();
							}catch(SQLException e){}
					}
		}
		System.out.println("\n\texit from  Engine.readAndInsertRetunOutwardTextFile()====>>>"+flg);
		//return flg;
		return true;
	}//end readAndInsertRetunOutwardTextFile

