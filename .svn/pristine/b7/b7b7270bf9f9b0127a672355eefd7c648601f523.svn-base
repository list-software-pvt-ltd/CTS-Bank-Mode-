	public boolean readAndInsertExtensionRequestTextFile()
		{
				System.out.println("\n\t inside Engine.readAndInsertExtensionRequestTextFile() =====");
				boolean flg=false;
				PreparedStatement psInsert=null;
				//Connection con=null;
				int recCount=0;
			try
			{
						String rec = "";
						String path=Configuration.getConfValByNm("CFG_uploadpath_to_chi",con)+"ExtensionRequest/";;
						String BOFD ="";
						String chequeNo ="";
						String sortCode ="";
						String tranCode ="";
						String amount ="";
						String accountNo ="";
						String retReasonCode ="";
						String payorbankroutNo="";
						String seq_uniqueNo="";
						String clearingType="";
						String period="";
						//con=Configuration.getConnection();
						//psInsert=con.prepareStatement("Insert into EXTENSION_OUTWARD values(?,?,?,?,?,?,?,?,?,?,?)");
						psInsert=con.prepareStatement("Insert into EXTENSION_OUTWARD(EXT_PRESENTINGBANKROUTNO,EXT_SERIALNO,EXT_PAYORBANKROUTNO,EXT_TRANSCODE,EXT_AMOUNT,EXT_ACCOUNTNO,EXT_EXTENSIONREASONCODE,EXT_EXTENSIONPERIOD,EXT_STATUS,EXT_DDMMYYYY) values(?,?,?,?,?,?,?,?,?,?)");
						BufferedReader br = new BufferedReader(new FileReader(path+"From_CBS_Extension_Request.txt"));

						while ((rec = br.readLine()) != null)
						{//1
									recCount++;
									BOFD =rec.substring(0,9);
									chequeNo =rec.substring(9,15);
									sortCode = rec.substring(15,24);
									tranCode = ""+Integer.parseInt(rec.substring(24,27));
									amount = rec.substring(27,45);//Amount
									accountNo = rec.substring(45,60);//Account No
									//accountNo = rec.substring(61,70);//Account No
									retReasonCode = rec.substring(60,62);//Ret Reason Code NOTE: 3 digits provided from CBS
									period=rec.substring(62,65);
									//payorbankroutNo= sortCode;//rec.substring(62,71);this change is done in CBS...
									payorbankroutNo=rec.substring(65,74);
									//seq_uniqueNo=rec.substring(62,77);//unique no 15 digits
									clearingType=rec.substring(74,76);
									psInsert.setString(1,BOFD);
									psInsert.setString(2,chequeNo);
									psInsert.setString(3,sortCode);
									psInsert.setString(4,tranCode);
									psInsert.setString(5,amount);
									psInsert.setString(6,accountNo);
									psInsert.setString(7,retReasonCode);
									psInsert.setString(8,""+Integer.parseInt(period));
									psInsert.setString(9,"Y");
									//psInsert.setString(10,payorbankroutNo);
									//psInsert.setString(10,seq_uniqueNo);//RTO_UNIQUENO
									psInsert.setString(10,Configuration.getDDMMYYYY());//RTO_DDMMYYYY chage it's index to 11
									//psInsert.setString(12,clearingType);

									try
									{
										int result=psInsert.executeUpdate();
											if(result>0)
												System.out.println("record is inserted..");
									}
									catch(SQLException e)
									{
											if(!(e.getMessage().indexOf("ORA-00001")>-1))
											{
												System.out.println(""+e);
												throw new Exception("Exception in Engine.readAndInsertExtensionRequestTextFile()");
											}
									}

						}//1
						br.close();
						/*if(recCount==0)
						{
							err_status="No record present in From_CBS_Extension_Request.txt";
						}
						else
						{
							flg=true;
						}*/
						if(recCount>0)
						{
								//err_status="No record present in From_CBS_Extension_Request.txt";
								new File(path+"From_CBS_Extension_Request.txt").delete();
						}
			}
			catch(FileNotFoundException e)
			{
					System.out.println("\n\tFileNotFoundException in Engine.readAndInsertExtensionRequestTextFile()"+e);
					if(e.getMessage().contains("FileNotFoundException"))
					{
						err_status="From_CBS_Extension_Request.txt is file not available on upload path.";
					}
					if(recCount==0)
					{
						err_status="No record present in From_CBS_Extension_Request.txt.";
					}
			}
			catch(StringIndexOutOfBoundsException e)
			{
						System.out.println("\n\tStringIndexOutOfBound in Engine.readAndInsertExtensionRequestTextFile()"+e);
						err_status="From_CBS_Extension_Request.txt file is Not in Proper format.";

			}
			catch(SQLException e)
			{
					System.out.println("\n\tSQLException in Engine.readAndInsertExtensionRequestTextFile()"+e);
					err_status="Problem at inserting record to ExtensionRequest Table.";
			}
			catch(Exception e)
			{
					System.out.println("\n\tException in Engine.readAndInsertExtensionRequestTextFile()"+e);
					err_status="Fail";
					e.printStackTrace();
			}
			/*finally
			{
					if(psInsert!=null && con!=null)
						{
								try
								{
									psInsert.close();
									con.close();
								}catch(SQLException e){}
						}
			}*/
			System.out.println("\n\texit from  Engine.readAndInsertExtensionRequestTextFile()====>>>"+flg);
			//return flg;
			return true;
	}//end readAndInsertExtensionRequestTextFile

	public String generateERF()
			{
						//ERF_416402000_10052014_125837_03
						System.out.println("*** inside generateERF *****");
						String retVal="";
						String ERF_name= GetFileName.getExtensionFileName("ERF",con);
						String[] strArr=ERF_name.split("_");
						String creationDate=strArr[2];
						String creationTime=strArr[3];

						String str_ERF_name=ERF_name;
						String ERF_done_name=ERF_name+".done";
						String fileId=ERF_name.substring(ERF_name.lastIndexOf("_")+1,ERF_name.lastIndexOf("."));
						XMLOutputFactory xof =  null;
						XMLStreamWriter xtw = null;


						FileOutputStream fos=null;
						long totAmt = 0;
						int totChq = 0;
						PreparedStatement psInsert=null;
						PreparedStatement psUpdate=null;
						PreparedStatement psexecute=null;
						PreparedStatement psRO=null;
						ResultSet rs=null,rs_count=null;
						//Connection con=null;

						int ExtensionRequestRecCount=0;
						try
						{
							String path=Configuration.getConfValByNm("CFG_uploadpath_to_chi",con)+"ExtensionRequest/";
							//con=Configuration.getConnection();
							psRO=con.prepareStatement("select count(*) from EXTENSION_OUTWARD where EXT_DDMMYYYY=? and EXT_STATUS='Y'");
							psRO.setString(1,Configuration.getDDMMYYYY());
							rs_count=psRO.executeQuery();
							while(rs_count.next())
							{
								 	ExtensionRequestRecCount=rs_count.getInt(1);
							}
							System.out.println("\n\t ExtensionRequestRecCount:"+ExtensionRequestRecCount);
							//psInsert=con.prepareStatement("Insert into EXTENSION_OUTWARD values(?,?,?,?,?,?,?,?,?)");
							psUpdate=con.prepareStatement("Update EXTENSION_OUTWARD set EXT_STATUS='D',EXT_FILENAME=? where EXT_PAYORBANKROUTNO=?");
							String rec = "";
							Statement st=con.createStatement(ResultSet.TYPE_SCROLL_INSENSITIVE,ResultSet.CONCUR_READ_ONLY);

							String sql="Select e.EXT_PRESENTINGBANKROUTNO,e.EXT_SERIALNO,e.EXT_PAYORBANKROUTNO,e.EXT_TRANSCODE,e.EXT_AMOUNT,";
							sql=sql+" e.EXT_ACCOUNTNO,e.EXT_EXTENSIONREASONCODE,c.CLI_CLEARINGTYPE,c.CLI_ITEMSEQUENCENO,c.CLI_PRESENTMENTDATE,";
							sql=sql+" c.CLI_CYCLENO,c.CLI_ACCOUNTNO,c.CLI_PRESENTINGBANKROUTNO,c.CLI_BOFDRoutNo,c.CLI_BOFDBUSDATE,";
							sql=sql+" c.CLI_DEPOSITORACCT,c.CLI_IFSC,e.EXT_EXTENSIONPERIOD from EXTENSION_OUTWARD e, CLEARINGINWARD c  where e.EXT_STATUS='Y'";
							sql=sql+" and e.EXT_DDMMYYYY=to_char((select max(to_date(c.CLI_DDMMYYYY,'ddmmyyyy')) from CLEARINGINWARD CL ";
							sql=sql+" WHERE CL.CLI_SERIALNO=c.CLI_SERIALNO AND c.CLI_PAYORBANKROUTNO=CL.CLI_PAYORBANKROUTNO AND ";
							sql=sql+" c.CLI_CLEARINGTYPE=CL.CLI_CLEARINGTYPE and c.CLI_TRANSCODE=CL.CLI_TRANSCODE  and c.CLI_AMOUNT = ";
							sql=sql+" CL.CLI_AMOUNT  ),'ddmmyyyy')  and e.EXT_DDMMYYYY='"+Configuration.getDDMMYYYY()+"' and e.EXT_SERIALNO=c.CLI_SERIALNO";
							sql=sql+" and e.EXT_PAYORBANKROUTNO=c.CLI_PAYORBANKROUTNO and e.EXT_CLEARINGTYPE=c.CLI_CLEARINGTYPE ";
							sql=sql+" and e.EXT_TRANSCODE=c.CLI_TRANSCODE  and to_number(e.EXT_AMOUNT)=to_number(c.CLI_AMOUNT )";

							System.out.println("sql:"+sql);
							rs=st.executeQuery(sql);
							xof =  XMLOutputFactory.newInstance();
							String micrFile=ERF_name;
							//path where to generaete ERF.xml
							String path_ERF= Configuration.getConfValByNm("CFG_uploadpath_to_chi",con);
							fos=new FileOutputStream(path_ERF+ERF_name);
							Writer writer = new OutputStreamWriter(fos, "UTF-8");
							xtw = xof.createXMLStreamWriter(writer);

							xtw.writeStartDocument("UTF-8","1.0");
							xtw.writeStartElement("FileHeader");
							xtw.writeAttribute("xmlns","urn:schemas-ncr-com:ECPIX:ERF:FileStructure:010003");
							xtw.writeAttribute("VersionNumber",versionnumber);
							xtw.writeAttribute("TestFileIndicator","P");// it must be P
							xtw.writeAttribute("CreationDate",creationDate);
							xtw.writeAttribute("CreationTime",creationTime);
							xtw.writeAttribute("FileID",fileId);//decide the FileID
						//get no of record in resultset
							int size = 0;
							if(rs.next())
							{
								rs.last();
								size = rs.getRow();
								rs.beforeFirst();
							}

							System.out.println("size:::>>>"+size);
					//now get one by one record and generate ERF..

						int counter=0;
						String statusStr="";
								if(size>0)
