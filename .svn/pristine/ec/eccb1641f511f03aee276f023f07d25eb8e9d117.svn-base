	public String getBranchFiles(String ftpUrl,int ftpPort,String ftpUser,String ftpPassword,String branchCode,String BRM_IFSCCODE)
	{//getBranchFiles
			PrintWriter fos=null;
			int cnt=0;
			boolean cbsTxtFileflg=false;
			StringBuffer disconnectedBranchesStatus=new StringBuffer();
			String msg="";
			int cbsFileCnt=0;
			System.out.println("\n\nIn getBranchFiles");
			int imageFileCount=0;
			FTPClient ftpClient = new FTPClient();
			System.out.println("\n\n111");
			FileInputStream inputStream = null;
			
			try
			{
				ftpClient.connect(ftpUrl,ftpPort);
				System.out.println("\n\nConnected To "+branchCode+"Branch.");
				//ftpClient.setFileType(FTPClient.BINARY_FILE_TYPE);
				 boolean login = ftpClient.login(ftpUser,ftpPassword);
				 System.out.println("\n\n111");
				  if (login)
		 		  {//1
						System.out.println("Connection established... with"+branchCode);
					   //list All Directories
						FTPFile[] mainfilelist=ftpClient.listFiles();
						int fileCount=mainfilelist.length;
						System.out.println("Server file Count:.."+fileCount);
						//System.out.println("Server file Count:.."+fileCount);
						if(fileCount!=0)
						{//2
							String fileString="";
							for(FTPFile f1:mainfilelist)
							{//3								
								String folderName=f1.getName();								
								System.out.println("\n\n\nfolderName:"+folderName);																
									if(folderName.endsWith(".txt"))
									{//3.1.1
											
										if(folderName.contains("From_CBS_Return_Outward.txt"))
										{//44		
												InputStream is=ftpClient.retrieveFileStream(folderName);	
												BufferedReader br=new BufferedReader(new InputStreamReader(is));																					
												String line=null;
												while((line=br.readLine())!=null)
												{//1
													branchCode=Configuration.lPad(branchCode,2,"0");
													fos.println(line);	
												}//1
												br.close();
												fos.close();
												is.close();//DSP
												//cbsTxtFileflg=true;											
												//convert images to byte array..
												if(!ftpClient.completePendingCommand())
												{ 
													ftpClient.logout(); 
													ftpClient.disconnect(); 
													System.err.println("File transfer failed."); 
												} 
												cbsTxtFileflg=true;	
												cnt++;
												ftpClient.deleteFile(folderName);								
										}//44
										else
										{//44
											 msg="Text File Name Should Be 'From_Cbs_Return_Outward.txt'!";
										}//44			
									}//3.1.1
									else
									{//3.1.1
										 msg="No Return Outward File Present at Branch";
									}//3.1.1	
							 }//3	
						 }//2
						 else
						 {//2
						 	msg="File Not Found at Branch.";
						 }//2
				   }//1 		 
				   else
					{//1
						 //msg="FAIL_TO_CONNECT_TO_BRANCH";	
						  msg="Failed To Connect To Branch!";	
					}//1	 	 		  
					//imageFlg=false,micrFlg=false,cbsTxtFileflg=false;;
					
					System.out.println("cbsTxtFileflg"+cbsTxtFileflg);
					//System.out.println("cbsTxtFileflg"+cbsTxtFileflg);	

					if(cbsTxtFileflg || cnt>0)
					{//1
							msg="SUCCESS";
					}//1
			}//try
			catch(FileNotFoundException e)
			{
				System.out.println("******** FileNotFoundException in getReturnOutward()"+e);
				 //msg=e.getMessage()+" This Folder is not Available at Upload path";
				if(cnt==0) 
					msg="FailCBS11";				
			}
			catch(java.net.ConnectException e)
			{
				disconnectedBranchesStatus.append(branchCode+" ");
			}
			catch(Exception e)
			{
				System.out.println("** Exception in getReturnOutwardFile.jsp"+e);
				if(cnt==0) 
					msg="FailCBS22";	
			}
			finally
			{
				try
				{
					ftpClient.logout(); 
					ftpClient.disconnect(); 
				}
				catch(Exception e)
				{
					System.out.println("** Exception in getReturnOutwardFile.jsp getBranchFile()"+e);
				}
			}		
				System.out.println("msg:>>>>"+msg);	
			return msg;
	}//getBranchFiles
	
	public String getBranchFilesLocal(String localPath,Connection con)
	{//getBranchFiles
	
		PrintWriter fos=null;
		int cnt=0;
		boolean cbsTxtFileflg=false;
		StringBuffer disconnectedBranchesStatus=new StringBuffer();
			String msg="";
			int cbsFileCnt=0;
			System.out.println("\n\nIn getBranchFiles");
			int imageFileCount=0;
			System.out.println("\n\n111");
			FileInputStream inputStream = null;
			
			try
			{
				 File path=new File(localPath);
				  //if (login)
		 		  {//1
					   //list All Directories
						File[] mainfilelist=path.listFiles();
						int fileCount=mainfilelist.length;
						System.out.println("Server file Count:.."+fileCount);
						//System.out.println("Server file Count:.."+fileCount);
						if(fileCount!=0)
						{//2
							String fileString="";
							for(File f1:mainfilelist)
							{//3								
								String folderName=f1.getName();								
								System.out.println("\n\n\nfolderName:"+folderName);																
									if(folderName.endsWith(".txt"))
									{//3.1.1
											
										if(folderName.contains("From_CBS_Return_Outward.txt"))
										{//44		
												//FileInputStream is=;	
												BufferedReader br=new BufferedReader(new InputStreamReader(new FileInputStream(localPath+"/"+folderName)));																					
												String line=null;
												fos=new PrintWriter(new File(Configuration.getConfValByNm("CFG_uploadpath_to_CHI",con)+ "/ReturnOutward/From_CBS_Return_Outward.txt"));
												while((line=br.readLine())!=null)
												{//1
													fos.println(line);
													
												}//1
												//br=null;
												br.close();
												fos.close();
												
												cbsTxtFileflg=true;	
												cnt++;
												System.out.println(f1.delete());								
										}//44
										else
										{//44
											 msg="Text File Name Should Be 'From_Cbs_Return_Outward.txt'!";
										}//44			
									}//3.1.1
									else
									{//3.1.1
										 msg="No Return Outward File Present at Branch";
									}//3.1.1	
							 }//3	
						 }//2
						 else
						 {//2
						 	msg="File Not Found at Branch.";
						 }//2
				   }//1
					//System.out.println("cbsTxtFileflg"+cbsTxtFileflg);
					//System.out.println("cbsTxtFileflg"+cbsTxtFileflg);	

					if(cbsTxtFileflg || cnt>0)
					{//1
							msg="SUCCESS";
					}//1
			}//try
			catch(FileNotFoundException e)
			{
				System.out.println("******** FileNotFoundException in getReturnOutward()"+e);
				 //msg=e.getMessage()+" This Folder is not Available at Upload path";
				if(cnt==0) 
					msg="FailCBS11";				
			}
			catch(Exception e)
			{
				e.printStackTrace();
				System.out.println("** Exception in getReturnOutwardFile.jsp"+e);
				if(cnt==0) 
					msg="FailCBS22";	
			}	
			System.out.println("msg:>>>>"+msg);	
			return msg;
	}//getBranchFiles
