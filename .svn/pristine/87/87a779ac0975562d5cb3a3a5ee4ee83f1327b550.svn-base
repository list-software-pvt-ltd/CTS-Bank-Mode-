package cts;

public class PPSIntimation {

	String PIL_TRANID, PIL_MOBNO, PIL_SMSTEXT, PIL_CHQNO, PIL_ACCNO, PIL_AMOUNT, PIL_DEVICEID, PIL_PAYEENAME, PIL_DTTM, PIL_ENTRYDATE, PIL_TRAN_CD, PIL_ISTRUMENT_DT, PIL_CBSRESPCD, PIL_CUSTID, PIL_RESPDESC;

	public PPSIntimation(String pIL_TRANID, String pIL_MOBNO, String pIL_SMSTEXT, String pIL_CHQNO, String pIL_ACCNO,
			String pIL_AMOUNT, String pIL_DEVICEID, String pIL_PAYEENAME, String pIL_DTTM, String pIL_ENTRYDATE,
			String pIL_TRAN_CD, String pIL_ISTRUMENT_DT, String pIL_CBSRESPCD, String pIL_CUSTID, String pIL_RESPDESC) {
		super();
		PIL_TRANID = pIL_TRANID;
		PIL_MOBNO = pIL_MOBNO;
		PIL_SMSTEXT = pIL_SMSTEXT;
		PIL_CHQNO = pIL_CHQNO;
		PIL_ACCNO = pIL_ACCNO;
		PIL_AMOUNT = pIL_AMOUNT;
		PIL_DEVICEID = pIL_DEVICEID;
		PIL_PAYEENAME = pIL_PAYEENAME;
		PIL_DTTM = pIL_DTTM;
		PIL_ENTRYDATE = pIL_ENTRYDATE;
		PIL_TRAN_CD = pIL_TRAN_CD;
		PIL_ISTRUMENT_DT = pIL_ISTRUMENT_DT;
		PIL_CBSRESPCD = pIL_CBSRESPCD;
		PIL_CUSTID = pIL_CUSTID;
		PIL_RESPDESC = pIL_RESPDESC;
	}
	
	public PPSIntimation()
	{
		
	}

	public String getPIL_TRANID() {
		return PIL_TRANID;
	}

	public void setPIL_TRANID(String pIL_TRANID) {
		PIL_TRANID = pIL_TRANID;
	}

	public String getPIL_MOBNO() {
		return PIL_MOBNO;
	}

	public void setPIL_MOBNO(String pIL_MOBNO) {
		PIL_MOBNO = pIL_MOBNO;
	}

	public String getPIL_SMSTEXT() {
		return PIL_SMSTEXT;
	}

	public void setPIL_SMSTEXT(String pIL_SMSTEXT) {
		PIL_SMSTEXT = pIL_SMSTEXT;
	}

	public String getPIL_CHQNO() {
		return PIL_CHQNO;
	}

	public void setPIL_CHQNO(String pIL_CHQNO) {
		PIL_CHQNO = pIL_CHQNO;
	}

	public String getPIL_ACCNO() {
		return PIL_ACCNO;
	}

	public void setPIL_ACCNO(String pIL_ACCNO) {
		PIL_ACCNO = pIL_ACCNO;
	}

	public String getPIL_AMOUNT() {
		return PIL_AMOUNT;
	}

	public void setPIL_AMOUNT(String pIL_AMOUNT) {
		PIL_AMOUNT = pIL_AMOUNT;
	}

	public String getPIL_DEVICEID() {
		return PIL_DEVICEID;
	}

	public void setPIL_DEVICEID(String pIL_DEVICEID) {
		PIL_DEVICEID = pIL_DEVICEID;
	}

	public String getPIL_PAYEENAME() {
		return PIL_PAYEENAME;
	}

	public void setPIL_PAYEENAME(String pIL_PAYEENAME) {
		PIL_PAYEENAME = pIL_PAYEENAME;
	}

	public String getPIL_DTTM() {
		return PIL_DTTM;
	}

	public void setPIL_DTTM(String pIL_DTTM) {
		PIL_DTTM = pIL_DTTM;
	}

	public String getPIL_ENTRYDATE() {
		return PIL_ENTRYDATE;
	}

	public void setPIL_ENTRYDATE(String pIL_ENTRYDATE) {
		PIL_ENTRYDATE = pIL_ENTRYDATE;
	}

	public String getPIL_TRAN_CD() {
		return PIL_TRAN_CD;
	}

	public void setPIL_TRAN_CD(String pIL_TRAN_CD) {
		PIL_TRAN_CD = pIL_TRAN_CD;
	}

	public String getPIL_ISTRUMENT_DT() {
		return PIL_ISTRUMENT_DT;
	}

	public void setPIL_ISTRUMENT_DT(String pIL_ISTRUMENT_DT) {
		PIL_ISTRUMENT_DT = pIL_ISTRUMENT_DT;
	}

	public String getPIL_CBSRESPCD() {
		return PIL_CBSRESPCD;
	}

	public void setPIL_CBSRESPCD(String pIL_CBSRESPCD) {
		PIL_CBSRESPCD = pIL_CBSRESPCD;
	}

	public String getPIL_CUSTID() {
		return PIL_CUSTID;
	}

	public void setPIL_CUSTID(String pIL_CUSTID) {
		PIL_CUSTID = pIL_CUSTID;
	}

	public String getPIL_RESPDESC() {
		return PIL_RESPDESC;
	}

	public void setPIL_RESPDESC(String pIL_RESPDESC) {
		PIL_RESPDESC = pIL_RESPDESC;
	}

	
	
}
