package cts;

public class SingleItem
{

	String CurrencyInd;
	String IQAIgnoreInd;
	String UserField;
	String TruncatingRTNo;
	String SpecialHandling;
	String MICRRepairFlags;
	String DocType;
	String ClearingType;
	String NumOfImageViews;
	String CycleNo;
	String PresentmentDate;
	String PresentingBankRoutNo;
	String TransCode;
	String SerialNo;
	String AccountNo;
	String Amount;
	String PayorBankRoutNo;
	String ItemSeqNo;

	public SingleItem()
	{}
	public SingleItem(String currencyInd, String iQAIgnoreInd,
			String userField, String truncatingRTNo, String specialHandling,
			String mICRRepairFlags, String docType, String clearingType,
			String numOfImageViews, String cycleNo, String presentmentDate,
			String presentingBankRoutNo, String transCode, String serialNo,
			String accountNo, String amount, String payorBankRoutNo,
			String itemSeqNo) {

		CurrencyInd = currencyInd;
		IQAIgnoreInd = iQAIgnoreInd;
		UserField = userField;
		TruncatingRTNo = truncatingRTNo;
		SpecialHandling = specialHandling;
		MICRRepairFlags = mICRRepairFlags;
		DocType = docType;
		ClearingType = clearingType;
		NumOfImageViews = numOfImageViews;
		CycleNo = cycleNo;
		PresentmentDate = presentmentDate;
		PresentingBankRoutNo = presentingBankRoutNo;
		TransCode = transCode;
		SerialNo = serialNo;
		AccountNo = accountNo;
		Amount = amount;
		PayorBankRoutNo = payorBankRoutNo;
		ItemSeqNo = itemSeqNo;
	}


	public String getCurrencyInd() {
		return CurrencyInd;
	}

	public void setCurrencyInd(String currencyInd) {
		CurrencyInd = currencyInd;
	}

	public String getIQAIgnoreInd() {
		return IQAIgnoreInd;
	}

	public void setIQAIgnoreInd(String iQAIgnoreInd) {
		IQAIgnoreInd = iQAIgnoreInd;
	}

	public String getUserField() {
		return UserField;
	}

	public void setUserField(String userField) {
		UserField = userField;
	}

	public String getTruncatingRTNo() {
		return TruncatingRTNo;
	}

	public void setTruncatingRTNo(String truncatingRTNo) {
		TruncatingRTNo = truncatingRTNo;
	}

	public String getSpecialHandling() {
		return SpecialHandling;
	}

	public void setSpecialHandling(String specialHandling) {
		SpecialHandling = specialHandling;
	}

	public String getMICRRepairFlags() {
		return MICRRepairFlags;
	}

	public void setMICRRepairFlags(String mICRRepairFlags) {
		MICRRepairFlags = mICRRepairFlags;
	}

	public String getDocType() {
		return DocType;
	}

	public void setDocType(String docType) {
		DocType = docType;
	}

	public String getClearingType() {
		return ClearingType;
	}

	public void setClearingType(String clearingType) {
		ClearingType = clearingType;
	}

	public String getNumOfImageViews() {
		return NumOfImageViews;
	}

	public void setNumOfImageViews(String numOfImageViews) {
		NumOfImageViews = numOfImageViews;
	}

	public String getCycleNo() {
		return CycleNo;
	}





	public void setCycleNo(String cycleNo) {
		CycleNo = cycleNo;
	}





	public String getPresentmentDate() {
		return PresentmentDate;
	}





	public void setPresentmentDate(String presentmentDate) {
		PresentmentDate = presentmentDate;
	}





	public String getPresentingBankRoutNo() {
		return PresentingBankRoutNo;
	}





	public void setPresentingBankRoutNo(String presentingBankRoutNo) {
		PresentingBankRoutNo = presentingBankRoutNo;
	}





	public String getTransCode() {
		return TransCode;
	}





	public void setTransCode(String transCode) {
		TransCode = transCode;
	}





	public String getSerialNo() {
		return SerialNo;
	}





	public void setSerialNo(String serialNo) {
		SerialNo = serialNo;
	}





	public String getAccountNo() {
		return AccountNo;
	}





	public void setAccountNo(String accountNo) {
		AccountNo = accountNo;
	}





	public String getAmount() {
		return Amount;
	}





	public void setAmount(String amount) {
		Amount = amount;
	}





	public String getPayorBankRoutNo() {
		return PayorBankRoutNo;
	}





	public void setPayorBankRoutNo(String payorBankRoutNo) {
		PayorBankRoutNo = payorBankRoutNo;
	}





	public String getItemSeqNo() {
		return ItemSeqNo;
	}





	public void setItemSeqNo(String itemSeqNo) {
		ItemSeqNo = itemSeqNo;
	}






}//end class
