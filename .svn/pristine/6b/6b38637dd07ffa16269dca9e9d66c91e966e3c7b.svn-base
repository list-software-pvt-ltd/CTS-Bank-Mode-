	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="dateString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["01012014"]]></defaultValueExpression>
	</parameter>
	<parameter name="branchString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="bankName" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="clearingType" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["01"]]></defaultValueExpression>
	</parameter>
	<parameter name="prm_subrptpath" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["//"]]></defaultValueExpression>
	</parameter>
	<parameter name="HAS_PROCESSED_RETURN" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["\\"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT
     CLEARINGOUTWARD."CLO_CHQNO" AS CLEARINGOUTWARD_CLO_CHQNO,
     CLEARINGOUTWARD."CLO_SORTCD" AS CLEARINGOUTWARD_CLO_SORTCD,
     CLEARINGOUTWARD."CLO_TRANCD" AS CLEARINGOUTWARD_CLO_TRANCD,
     CLEARINGOUTWARD."CLO_AMOUNT" AS CLEARINGOUTWARD_CLO_AMOUNT,
     CLEARINGOUTWARD."CLO_PAYEE_ACCNO" AS CLEARINGOUTWARD_CLO_PAYEE_ACCN,
     CLEARINGOUTWARD."CLO_PAYEE_ACCNM" AS CLEARINGOUTWARD_CLO_PAYEE_ACNM,
     CLEARINGOUTWARD."CLO_DRAWEE_ACCNO" AS CLEARINGOUTWARD_CLO_DRAWEE_ACC,
     to_char(to_date(CLEARINGOUTWARD."CLO_DATE_DDMMYYYY",'dd/mm/yyyy'),'dd/mm/yyyy') AS CLEARINGOUTWARD_CLO_DATE_DDMMY,
     CLEARINGOUTWARD."CLO_BRANCH_CD" AS CLEARINGOUTWARD_CLO_BRANCH_CD,
     CLEARINGOUTWARD."CLO_IQASTATUS" AS CLEARINGOUTWARD_CLO_IQASTATUS,
     substr(CLEARINGOUTWARD."CLO_XMLFILENAME",1,29) AS CLEARINGOUTWARD_CLO_XMLFILENAM,
     BRANCHMSTR."BRM_BRNCD" AS BRANCHMSTR_BRM_BRNCD,
     BRANCHMSTR."BRM_BRNNM" AS BRANCHMSTR_BRM_BRNNM,
     BRANCHMSTR."BRM_BRNCD"||'-'||BRANCHMSTR."BRM_BRNNM" AS BNK_BRANCH,
      decode($P{HAS_PROCESSED_RETURN},'N','NA','Y',nvl(RETINWRETCODES."RETDESCR",'Accepted')) as return_status,
 decode(CLEARINGOUTWARD."CLO_CONVERT_FLG",'N','Not Uploaded','Y','Saved and Uploaded','D',decode(nvl(CLO_REJECTREASON,'D'),'0','Accepted By NPCI','D','Sent To NPCI','Rejected By NPCI')) as status
FROM
     "CLEARINGOUTWARD" CLEARINGOUTWARD left outer join
     "BRANCHMSTR" BRANCHMSTR 
     on
      BRANCHMSTR."BRM_MICRCD"=CLEARINGOUTWARD."CLO_BOFD"
     left outer join 
      
     "RETURNINWARD" RETURNINWARD 
     on 
     RETURNINWARD."RTI_PRESENTMENTDATE"=CLEARINGOUTWARD."CLO_DATE_DDMMYYYY" and RETURNINWARD."RTI_ITEMSEQNO"=CLEARINGOUTWARD."CLO_ITEMSEQNO"
     left outer join 
     "RETINWRETCODES" RETINWRETCODES
     on RETURNINWARD."RTI_RETURNREASON"=RETINWRETCODES."RETCODE" 
WHERE
     CLEARINGOUTWARD."CLO_DATE_DDMMYYYY" = $P{dateString}
 AND CLEARINGOUTWARD."CLO_BOFD"=BRANCHMSTR."BRM_MICRCD"
 AND BRANCHMSTR."BRM_BRNCD" = $P{branchString}
AND CLEARINGOUTWARD."CLO_CLEARINGTYPE" = $P{clearingType}
ORDER BY
     CLO_XMLFILENAME ASC,
     CLEARINGOUTWARD_CLO_BRANCH_CD ASC]]></queryString>

