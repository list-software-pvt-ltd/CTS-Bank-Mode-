package cts;
import java.util.ArrayList;
public class ItemClass
{
		ArrayList<AddendATag> _AddendATag;
		ArrayList<MICRDS> _MICRDS;
		ArrayList<SingleItem> _SingleItem;

		public ItemClass()
		{}
		public ItemClass(ArrayList<AddendATag> _AddendATag,
				ArrayList<MICRDS> _MICRDS, ArrayList<SingleItem> _SingleItem) {
			super();
			this._AddendATag = _AddendATag;
			this._MICRDS = _MICRDS;
			this._SingleItem = _SingleItem;
		}


		public ArrayList<AddendATag> get_AddendATag() {
			return _AddendATag;
		}


		public void set_AddendATag(ArrayList<AddendATag> _AddendATag) {
			this._AddendATag = _AddendATag;
		}


		public ArrayList<MICRDS> get_MICRDS() {
			return _MICRDS;
		}


		public void set_MICRDS(ArrayList<MICRDS> _MICRDS) {
			this._MICRDS = _MICRDS;
		}


		public ArrayList<SingleItem> get_SingleItem() {
			return _SingleItem;
		}


		public void set_SingleItem(ArrayList<SingleItem> _SingleItem) {
			this._SingleItem = _SingleItem;
		}

}
