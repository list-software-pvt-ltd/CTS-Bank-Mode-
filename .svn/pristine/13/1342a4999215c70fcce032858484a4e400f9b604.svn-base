	<field name="CLEARINGINWARD_CLI_BOFDROUTNO" class="java.lang.String"/>
	<field name="BNK_NAME" class="java.lang.String"/>

	<variable name="amount" class="java.lang.Double" resetType="Report" calculation="Nothing">
