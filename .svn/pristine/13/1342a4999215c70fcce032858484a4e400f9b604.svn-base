	<parameter name="dateString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["01012014"]]></defaultValueExpression>
	</parameter>
	<parameter name="branchString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="bankName" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT
     CLEARINGINWARD."CLI_SERIALNO" AS CLEARINGINWARD_CLI_SERIALNO,CLI_BOFDROUTNO,
     CLEARINGINWARD."CLI_PAYORBANKROUTNO" AS CLI_PAYORBANKROUTNO,
     CLEARINGINWARD."CLI_AMOUNT" AS CLEARINGINWARD_CLI_AMOUNT,
     CLEARINGINWARD."CLI_TRUNCATINGRTNO" AS CLI_TRUNCATINGRTNO,
     to_char(to_date(CLEARINGINWARD."CLI_DDMMYYYY",'DD/MM/YYYY'),'DD/MM/YYYY') AS CLEARINGINWARD_CLI_DATE_DDMMY,
     CLEARINGINWARD."CLI_DOCTYPE" AS CLEARINGINWARD_CLI_DOCTYPE,
     CLEARINGINWARD."CLI_BOFDROUTNO" AS CLEARINGINWARD_CLI_BOFDROUTNO,
     nvl((select BNK_NAME from BANKMASTER_CHM where BNK_ROUTING_NBR=(select BRN_BNK_ROUTING_NBR from BRANCHMASTER_CHM where BRN_ROUTING_NBR=CLEARINGINWARD."CLI_BOFDROUTNO")),CLI_BOFDROUTNO) BNK_NAME             
FROM
    "CLEARINGINWARD" CLEARINGINWARD    
WHERE 

    CLEARINGINWARD."CLI_DDMMYYYY"=$P{dateString}
AND
    CLEARINGINWARD."CLI_DOCTYPE"='C' order by BNK_NAME]]></queryString>

