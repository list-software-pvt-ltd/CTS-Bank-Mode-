	<parameter name="dateString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["01012014"]]></defaultValueExpression>
	</parameter>
	<parameter name="bankName" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[--------------------------------------------------------------------------------------------
select RTO_CHEQUENO, nvl(BRM_BRNCD||'--'||BRM_BRNNM,RTO_SORTCODE)RTO_SORTCODE,(RTO_AMOUNT/100)RTO_AMOUNT,OACK_ITEMSTATUS,RTO_XMLFILENAME,
nvl ((select distinct BNK_NAME from BANKMASTER_CHM left join BRANCHMASTER_CHM on BNK_CC_ROUTING_NBR=BRN_BNK_ROUTING_NBR 
 and BNK_ROUTING_NBR=BRN_BNK_ROUTING_NBR where BNK_ROUTING_NBR=OACK_PRESENTINGBANKROUTNO), OACK_PRESENTINGBANKROUTNO) OACK_PRESENTINGBANKROUTNO,to_char(to_date(OACK_PRESENTMENTDATE,'dd/mm/yyyy'),'dd/mm/yyyy') OACK_PRESENTMENTDATE
from OACK join CLEARINGINWARD on 
OACK_ITEMSEQNO=CLI_ITEMSEQUENCENO and 
OACK_PRESENTINGBANKROUTNO=CLI_PRESENTINGBANKROUTNO and
OACK_PRESENTMENTDATE=CLI_PRESENTMENTDATE join 
 RETRUNOUTWARD on 
CLI_SERIALNO=RTO_CHEQUENO and 
CLI_DDMMYYYY=RTO_DDMMYYYY and
CLI_PAYORBANKROUTNO=RTO_PAYORBANKROUTNO and 
to_number(CLI_AMOUNT)=to_number(RTO_AMOUNT) 
and to_number(CLI_TRANSCODE)=to_number(RTO_TRANSACTIONCODE)
 left outer join BRANCHMSTR on CLI_PAYORBANKROUTNO=BRM_MICRCD
 where CLI_DDMMYYYY=$P{dateString} 
order by BRM_BRNCD]]></queryString>

	<field name="RTO_CHEQUENO" class="java.lang.String"/>
