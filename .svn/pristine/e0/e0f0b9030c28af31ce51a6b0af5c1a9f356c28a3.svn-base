	<variable name="grandTotAmt" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{RTO_AMOUNT}]]></variableExpression>
	</variable>
	<variable name="brnTotAmt" class="java.math.BigDecimal" resetType="Group" resetGroup="Filename" calculation="Sum">
