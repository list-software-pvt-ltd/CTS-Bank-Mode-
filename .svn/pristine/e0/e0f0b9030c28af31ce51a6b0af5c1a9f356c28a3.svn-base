	</variable>
	<variable name="srNo" class="java.lang.Integer" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new Integer($V{srNo}.intValue()+1)]]></variableExpression>
		<initialValueExpression><![CDATA[new Integer(0)]]></initialValueExpression>
	</variable>
	<variable name="totAmt" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{RTO_AMOUNT}]]></variableExpression>
	</variable>

