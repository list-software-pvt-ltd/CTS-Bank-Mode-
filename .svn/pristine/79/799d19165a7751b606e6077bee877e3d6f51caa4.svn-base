package cts;
import java.util.*;
public class Item
{//Item
		private ArrayList<ItemInformation> _itemInfoBeanAl=null;
		private ArrayList<ImageBean> _imageBeanAl=null;
		private ArrayList<MicrDataInformation> _micrBeanAl=null;
		private ArrayList<AddendATag> _addendATagAl=null;

		//itemBean=new Item(_itemInfoBeanAl,_micrBeanAl,_imageBeanAl);
		public Item()
		{}
		public Item(ArrayList<ItemInformation> _itemInfoBeanAl,ArrayList<MicrDataInformation> _micrBeanAl,ArrayList<ImageBean> _imageBeanAl,ArrayList<AddendATag> _addendATagAl)
		{//Item
						this. _itemInfoBeanAl=_itemInfoBeanAl;
						this._imageBeanAl=_imageBeanAl;
						this._micrBeanAl=_micrBeanAl;
						this._addendATagAl=_addendATagAl;
		}//Item

			public ArrayList<ItemInformation> getItemInfoBeanAl()
			{
					return _itemInfoBeanAl;
			}

			public ArrayList<AddendATag> getAddendATagAl()
			{
								return _addendATagAl;
			}

			public void setAddendATagAl(ArrayList<AddendATag> _addendATagAl)
			{
								this._addendATagAl=_addendATagAl;
			}

			public void setItemInfoBeanAl(ArrayList<ItemInformation> itemInfoBeanAl)
			{
				_itemInfoBeanAl = itemInfoBeanAl;
			}
			public ArrayList<ImageBean> getImageBeanAl()
			{
				return _imageBeanAl;
			}

			public void setImageBeanAl(ArrayList<ImageBean> imageBeanAl)
			{
				_imageBeanAl = imageBeanAl;
			}
			public ArrayList<MicrDataInformation> getMicrBeanAl()
			{
				return _micrBeanAl;
			}
			public void setMicrBeanAl(ArrayList<MicrDataInformation> micrBeanAl)
			{
				_micrBeanAl = micrBeanAl;
			}
}//Item