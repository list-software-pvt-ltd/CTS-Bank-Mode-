package cts;
public class MICRDS
{

	String SecurityKeyName;
	String SecurityAuthenticatorName;
	String SecurityOriginatorName;
	String SignatureData;
	String DigitalSignatureLength;
	String MICRFingerPrint;
	String SecurityKeySize;
	String DigitalSignatureMethod;
	String Source;

	public MICRDS()
	{}
	public MICRDS(String securityKeyName, String securityAuthenticatorName,
			String securityOriginatorName, String signatureData,
			String digitalSignatureLength, String mICRFingerPrint,
			String securityKeySize, String digitalSignatureMethod, String source) {
		super();
		SecurityKeyName = securityKeyName;
		SecurityAuthenticatorName = securityAuthenticatorName;
		SecurityOriginatorName = securityOriginatorName;
		SignatureData = signatureData;
		DigitalSignatureLength = digitalSignatureLength;
		MICRFingerPrint = mICRFingerPrint;
		SecurityKeySize = securityKeySize;
		DigitalSignatureMethod = digitalSignatureMethod;
		Source = source;
	}


	public String getSecurityKeyName() {
		return SecurityKeyName;
	}


	public void setSecurityKeyName(String securityKeyName) {
		SecurityKeyName = securityKeyName;
	}


	public String getSecurityAuthenticatorName() {
		return SecurityAuthenticatorName;
	}


	public void setSecurityAuthenticatorName(String securityAuthenticatorName) {
		SecurityAuthenticatorName = securityAuthenticatorName;
	}


	public String getSecurityOriginatorName() {
		return SecurityOriginatorName;
	}


	public void setSecurityOriginatorName(String securityOriginatorName) {
		SecurityOriginatorName = securityOriginatorName;
	}


	public String getSignatureData() {
		return SignatureData;
	}


	public void setSignatureData(String signatureData) {
		SignatureData = signatureData;
	}


	public String getDigitalSignatureLength() {
		return DigitalSignatureLength;
	}


	public void setDigitalSignatureLength(String digitalSignatureLength) {
		DigitalSignatureLength = digitalSignatureLength;
	}


	public String getMICRFingerPrint() {
		return MICRFingerPrint;
	}


	public void setMICRFingerPrint(String mICRFingerPrint) {
		MICRFingerPrint = mICRFingerPrint;
	}


	public String getSecurityKeySize() {
		return SecurityKeySize;
	}


	public void setSecurityKeySize(String securityKeySize) {
		SecurityKeySize = securityKeySize;
	}


	public String getDigitalSignatureMethod() {
		return DigitalSignatureMethod;
	}


	public void setDigitalSignatureMethod(String digitalSignatureMethod) {
		DigitalSignatureMethod = digitalSignatureMethod;
	}


	public String getSource() {
		return Source;
	}


	public void setSource(String source) {
		Source = source;
	}



}
