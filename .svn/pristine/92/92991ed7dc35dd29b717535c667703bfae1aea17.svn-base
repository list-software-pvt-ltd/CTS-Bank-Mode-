<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="clearing_inwardSumm_spcl"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="595"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="dateString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["01/01/2000"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select 
       trunc(nvl(BRANCHMSTR.BRM_BRNCD,'0')) as BRM_BRNCD,
      nvl(BRANCHMSTR."BRM_BRNNM",'Not Drawn Own Us') as BRM_BRNNM,
     sum((CLEARINGINWARD."CLI_AMOUNT")/100)AS CLEARINGINWARD_CLI_AMOUNT,
     count(CLEARINGINWARD."CLI_SERIALNO") AS CLEARINGINWARD_CLI_SERIALNO,
     to_char(to_date(CLEARINGINWARD."CLI_DDMMYYYY",'dd/mm/yyyy'),'dd/mm/yyyy') AS CLEARINGINWARD_CLI_DDMMYYYY
     
     FROM
     "CLEARINGINWARD" CLEARINGINWARD left outer join
     "BRANCHMSTR" BRANCHMSTR 
     on
    BRANCHMSTR."BRM_MICRCD"=CLEARINGINWARD."CLI_PAYORBANKROUTNO"
    where 
     CLEARINGINWARD."CLI_DDMMYYYY"=$P{dateString}
AND  CLI_CLEARINGTYPE='99'
    group by trunc(nvl(BRANCHMSTR.BRM_BRNCD,'0')),BRM_BRNNM,CLI_DDMMYYYY
    order by 1]]></queryString>

	<field name="BRM_BRNCD" class="java.math.BigDecimal"/>
	<field name="BRM_BRNNM" class="java.lang.String"/>
	<field name="CLEARINGINWARD_CLI_AMOUNT" class="java.math.BigDecimal"/>
	<field name="CLEARINGINWARD_CLI_SERIALNO" class="java.math.BigDecimal"/>
	<field name="CLEARINGINWARD_CLI_DDMMYYYY" class="java.lang.String"/>

	<variable name="Tot_Amount" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{CLEARINGINWARD_CLI_AMOUNT}]]></variableExpression>
	</variable>
	<variable name="Tot_cheque" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{CLEARINGINWARD_CLI_SERIALNO}]]></variableExpression>
	</variable>
