	<parameter name="dateString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["01/01/2000"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT ROWNUM,
(SELECT  CFG_BANKNAME FROM CONFIGURATION ) AS BANKNAME, 
(SELECT CFG_BANKROUTINGCODE FROM CONFIGURATION) AS ROUTING_CODE,
(SELECT COUNT(*) FROM CLEARINGINWARD WHERE CLI_DDMMYYYY=$P{dateString} ) TOTAL_COUNT,
(SELECT COUNT(*) FROM RETRUNOUTWARD WHERE RTO_DDMMYYYY=$P{dateString} AND RTO_RETURNREASONCODE='00') REALIZED,
(SELECT COUNT(*) FROM RETRUNOUTWARD WHERE RTO_DDMMYYYY=$P{dateString} AND RTO_RETURNREASONCODE<>'00') RETURNED,
(SELECT COUNT(*) FROM RETRUNOUTWARD WHERE RTO_DDMMYYYY=$P{dateString}  AND RTO_RETURNREASONCODE IS NULL) EXTENED
FROM DUAL]]></queryString>

