		<variableExpression><![CDATA[new Double(Double.parseDouble($F{CLO_AMOUNT})/100)]]></variableExpression>
	</variable>
	<variable name="brnTotAmt" class="java.lang.Double" resetType="Group" resetGroup="Filename" calculation="Sum">
		<variableExpression><![CDATA[new Double(Double.parseDouble($F{CLO_AMOUNT})/100)]]></variableExpression>
	</variable>
	<variable name="srNo" class="java.lang.Integer" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new Integer($V{srNo}.intValue()+1)]]></variableExpression>
		<initialValueExpression><![CDATA[new Integer(0)]]></initialValueExpression>
	</variable>
	<variable name="totAmt" class="java.lang.Double" resetType="Report" calculation="Sum">
