	<queryString><![CDATA[select CLO_CHQNO,(BRM_BRNCD||'--'||BRM_BRNNM) BRM_BRNNM, CLO_AMOUNT,OACK_ITEMSTATUS,CLO_XMLFILENAME,
to_char(to_date(OACK_PRESENTMENTDATE,'dd/mm/yyyy'),'dd/mm/yyyy') OACK_PRESENTMENTDATE,
nvl ((select distinct BNK_NAME from BANKMASTER_CHM left join BRANCHMASTER_CHM on BNK_CC_ROUTING_NBR=BRN_BNK_ROUTING_NBR 
and BNK_ROUTING_NBR=BRN_BNK_ROUTING_NBR where BRN_ROUTING_NBR=CLO_SORTCD),CLO_SORTCD) OACK_PRESENTINGBANKROUTNO
from OACK join CLEARINGOUTWARD on  OACK_ITEMSEQNO=CLO_ITEMSEQNO and 
OACK_PRESENTMENTDATE=CLO_DATE_DDMMYYYY join BRANCHMSTR on CLO_BRANCH_CD=BRM_BRNCD
where OACK_PRESENTMENTDATE=$P{dateString}
order by BRM_BRNCD,CLO_XMLFILENAME]]></queryString>

	<field name="CLO_CHQNO" class="java.lang.String"/>
	<field name="BRM_BRNNM" class="java.lang.String"/>
