	<parameter name="dateString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["01012014"]]></defaultValueExpression>
	</parameter>
	<parameter name="branchString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="bankName" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="imagepath" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="CTS_TYPE" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT
     CLEARINGINWARD."CLI_PAYORBANKROUTNO" AS CLEARINGINWARD_CLI_PAYORBANKRO,
     CLEARINGINWARD."CLI_AMOUNT" AS CLEARINGINWARD_CLI_AMOUNT,
     CLEARINGINWARD."CLI_SERIALNO" AS CLEARINGINWARD_CLI_SERIALNO,
     CLEARINGINWARD."CLI_TRANSCODE" AS CLEARINGINWARD_CLI_TRANSCODE,
     CLEARINGINWARD."CLI_ACCOUNTNO" AS CLEARINGINWARD_CLI_ACCOUNTNO,
     CLEARINGINWARD."CLI_BOFDROUTNO" AS CLEARINGINWARD_CLI_BOFDROUTNO,
     CLEARINGINWARD."CLI_IMAGEFILE3" as CLEARINGINWARD_CLI_IMAGEFILE3,
     substr(CLEARINGINWARD."CLI_XMLFILENAME",1,26) AS CLEARINGINWARD_CLI_XMLFILENAME,
     BRANCHMSTR."BRM_MICRCD" AS BRANCHMSTR_BRM_MICRCD,
     nvl(BRANCHMSTR."BRM_BRNCD",'-1') AS BRANCHMSTR_BRM_BRNCD,
     nvl(BRANCHMSTR."BRM_BRNCD",'-1')||'--'||nvl(BRANCHMSTR."BRM_BRNNM",'Not Drawn on Us') AS BRN_CD_BRN_NAME,
    decode(nvl(RETRUNOUTWARD."RTO_RETURNREASONCODE",'NA'),'NA','ACCEPTED',RETINWRETCODES."RETDESCR") as return_status
FROM
     "CLEARINGINWARD" CLEARINGINWARD left outer join
     "BRANCHMSTR" BRANCHMSTR
on
    BRANCHMSTR."BRM_MICRCD"=CLEARINGINWARD."CLI_PAYORBANKROUTNO"
     left outer join "RETRUNOUTWARD" RETRUNOUTWARD
on  RETRUNOUTWARD."RTO_DDMMYYYY"  =CLEARINGINWARD."CLI_DDMMYYYY" and CLEARINGINWARD."CLI_CLRSRNO"=RETRUNOUTWARD."RTO_ITEMSEQUENCENO"
 left outer join "RETINWRETCODES" RETINWRETCODES 
 on  RETINWRETCODES."RETCODE"=RETRUNOUTWARD."RTO_RETURNREASONCODE"
where
   CLEARINGINWARD."CLI_DDMMYYYY"=$P{dateString}
AND
   CLEARINGINWARD."CLI_CLEARINGTYPE"=DECODE($P{CTS_TYPE},'ALL',CLI_CLEARINGTYPE,$P{CTS_TYPE})
AND  instr($P{branchString},'--'||nvl(BRANCHMSTR."BRM_BRNCD",'-1')||'--' )>0
order by
 BRM_BRNCD ASC,
 CLI_TRANSCODE ASC]]></queryString>

