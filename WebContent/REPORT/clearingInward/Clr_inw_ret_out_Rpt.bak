	<parameter name="bankName" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="show_from_date" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="show_to_date" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select to_char(to_date(CLI_DDMMYYYY,'dd-mm-yyyy'),'dd-mm-yyyy')CLI_DDMMYYYY,
count(CLI_SERIALNO)CLI_SERIALNO,
(sum(CLI_AMOUNT)/100) CLI_AMOUNT,
(select count(RTO_CHEQUENO) from RETRUNOUTWARD where RTO_DDMMYYYY= CLI_DDMMYYYY) RTO_CHEQUENO,
nvl((select SUM(RTO_AMOUNT)/100 from RETRUNOUTWARD where RTO_DDMMYYYY= CLI_DDMMYYYY),0) RTO_AMOUNT
from CLEARINGINWARD  where to_date(CLI_DDMMYYYY,'dd-mm-yyyy') 
between to_date($P{show_from_date},'dd-mm-yyyy') and to_date($P{show_to_date},'dd-mm-yyyy') group by CLI_DDMMYYYY 
order by to_date(CLI_DDMMYYYY,'dd-mm-yyyy')]]></queryString>

