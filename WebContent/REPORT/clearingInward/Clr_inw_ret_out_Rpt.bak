	<field name="CLI_SERIALNO" class="java.math.BigDecimal"/>
	<field name="CLI_AMOUNT" class="java.math.BigDecimal"/>
	<field name="RTO_CHEQUENO" class="java.math.BigDecimal"/>
	<field name="RTO_AMOUNT" class="java.math.BigDecimal"/>

	<variable name="inwTotamt" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
