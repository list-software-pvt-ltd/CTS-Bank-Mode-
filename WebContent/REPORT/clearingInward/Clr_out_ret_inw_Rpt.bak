	<parameter name="bankName" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="show_from_date" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="show_to_date" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select  to_char(to_date(CLO_DATE_DDMMYYYY,'dd-mm-yyyy'),'dd-mm-yyyy')CLO_DATE_DDMMYYYY,
count(CLO_CHQNO)CLO_CHQNO, (sum(CLO_AMOUNT)/100) CLO_AMOUNT, 
(select count(RTI_SERIALNO) from RETURNINWARD where RTI_PRESENTMENTDATE= CLO_DATE_DDMMYYYY) RTI_SERIALNO,
nvl((select SUM(RTI_AMOUNT)/100 from RETURNINWARD where RTI_PRESENTMENTDATE= CLO_DATE_DDMMYYYY),0) RTI_AMOUNT
from CLEARINGOUTWARD where to_date(CLO_DATE_DDMMYYYY,'dd-mm-yyyy') 
between to_date($P{show_from_date},'dd-mm-yyyy') and to_date($P{show_to_date},'dd-mm-yyyy') group by CLO_DATE_DDMMYYYY 
order by to_date(CLO_DATE_DDMMYYYY,'dd-mm-yyyy')]]></queryString>

	<field name="CLO_DATE_DDMMYYYY" class="java.lang.String"/>
	<field name="CLO_CHQNO" class="java.math.BigDecimal"/>
	<field name="CLO_AMOUNT" class="java.math.BigDecimal"/>
	<field name="RTI_SERIALNO" class="java.math.BigDecimal"/>
	<field name="RTI_AMOUNT" class="java.math.BigDecimal"/>

	<variable name="inwTotamt" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{RTI_AMOUNT}]]></variableExpression>
	</variable>
	<variable name="inwTotChek" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{RTI_SERIALNO}]]></variableExpression>
	</variable>
	<variable name="OutTotChek" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{CLO_CHQNO}]]></variableExpression>
	</variable>
	<variable name="OutTotAMt" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{CLO_AMOUNT}]]></variableExpression>
	</variable>
