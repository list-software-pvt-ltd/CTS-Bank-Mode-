		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="dateString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["01012014"]]></defaultValueExpression>
	</parameter>
	<parameter name="branchString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="bankName" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT
     CLEARINGINWARD."CLI_PAYORBANKROUTNO" AS CLEARINGINWARD_CLI_PAYORBANKRO,
     CLEARINGINWARD."CLI_AMOUNT" AS CLEARINGINWARD_CLI_AMOUNT,
     CLEARINGINWARD."CLI_SERIALNO" AS CLEARINGINWARD_CLI_SERIALNO,
     CLEARINGINWARD."CLI_TRANSCODE" AS CLEARINGINWARD_CLI_TRANSCODE,
     CLEARINGINWARD."CLI_ACCOUNTNO" AS CLEARINGINWARD_CLI_ACCOUNTNO,
     CLEARINGINWARD."CLI_BOFDROUTNO" AS CLEARINGINWARD_CLI_BOFDROUTNO,
     substr(CLEARINGINWARD."CLI_XMLFILENAME",1,26) AS CLEARINGINWARD_CLI_XMLFILENAME,
     BRANCHMSTR."BRM_MICRCD" AS BRANCHMSTR_BRM_MICRCD,
     --BRANCHMSTR."BRM_BRNCD" AS BRANCHMSTR_BRM_BRNCD,
    -- BRANCHMSTR."BRM_BRNCD"||'--'||BRANCHMSTR."BRM_BRNNM" AS BRN_CD_BRN_NAME
     nvl(BRANCHMSTR."BRM_BRNCD",'-1') AS BRANCHMSTR_BRM_BRNCD,
     nvl(BRANCHMSTR."BRM_BRNCD",'-1')||'--'||nvl(BRANCHMSTR."BRM_BRNNM",'Not Drawn on Us') AS BRN_CD_BRN_NAME,
    decode(nvl(RETRUNOUTWARD."RTO_RETURNREASONCODE",'NA'),'NA','ACCEPTED',RETINWRETCODES."RETDESCR") as return_status,
     CLEARINGINWARD."CLI_CPPSFLAG" AS CLEARINGINWARD_CLI_CPPSFLAG,
(select count(*) from CLEARINGINWARD left outer join
     "BRANCHMSTR" BRANCHMSTR on
    BRANCHMSTR."BRM_MICRCD"=CLEARINGINWARD."CLI_PAYORBANKROUTNO" where CLEARINGINWARD.CLI_CPPSFLAG='P' and CLEARINGINWARD."CLI_DDMMYYYY"=$P{dateString} AND
   nvl(BRANCHMSTR."BRM_BRNCD",'-1')=DECODE($P{branchString},'ALL',BRM_BRNCD,'-1','-1',$P{branchString})) as pflag,
 (select count(*) from CLEARINGINWARD left outer join
     "BRANCHMSTR" BRANCHMSTR on
    BRANCHMSTR."BRM_MICRCD"=CLEARINGINWARD."CLI_PAYORBANKROUTNO" where CLEARINGINWARD.CLI_CPPSFLAG='D' and CLEARINGINWARD."CLI_DDMMYYYY"=$P{dateString} AND
   nvl(BRANCHMSTR."BRM_BRNCD",'-1')=DECODE($P{branchString},'ALL',BRM_BRNCD,'-1','-1',$P{branchString})) as dflag,
 (select count(*) from CLEARINGINWARD left outer join
     "BRANCHMSTR" BRANCHMSTR on
    BRANCHMSTR."BRM_MICRCD"=CLEARINGINWARD."CLI_PAYORBANKROUTNO" where CLEARINGINWARD.CLI_CPPSFLAG='Y' and CLEARINGINWARD."CLI_DDMMYYYY"=$P{dateString} AND
   nvl(BRANCHMSTR."BRM_BRNCD",'-1')=DECODE($P{branchString},'ALL',BRM_BRNCD,'-1','-1',$P{branchString})) as yflag,
 (select count(*) from CLEARINGINWARD left outer join
     "BRANCHMSTR" BRANCHMSTR on
    BRANCHMSTR."BRM_MICRCD"=CLEARINGINWARD."CLI_PAYORBANKROUTNO" where CLEARINGINWARD.CLI_CPPSFLAG='Z' and CLEARINGINWARD."CLI_DDMMYYYY"=$P{dateString} AND
   nvl(BRANCHMSTR."BRM_BRNCD",'-1')=DECODE($P{branchString},'ALL',BRM_BRNCD,'-1','-1',$P{branchString})) as zflag,
 (select count(*) from CLEARINGINWARD left outer join
     "BRANCHMSTR" BRANCHMSTR on
    BRANCHMSTR."BRM_MICRCD"=CLEARINGINWARD."CLI_PAYORBANKROUTNO" where CLEARINGINWARD.CLI_CPPSFLAG='N' and CLEARINGINWARD."CLI_DDMMYYYY"=$P{dateString} AND
   nvl(BRANCHMSTR."BRM_BRNCD",'-1')=DECODE($P{branchString},'ALL',BRM_BRNCD,'-1','-1',$P{branchString})) as nflag,
(select count(*) from CLEARINGINWARD left outer join
     "BRANCHMSTR" BRANCHMSTR on
    BRANCHMSTR."BRM_MICRCD"=CLEARINGINWARD."CLI_PAYORBANKROUTNO" where CLEARINGINWARD."CLI_DDMMYYYY"=$P{dateString} AND
   nvl(BRANCHMSTR."BRM_BRNCD",'-1')=DECODE($P{branchString},'ALL',BRM_BRNCD,'-1','-1',$P{branchString})) as totalcnt
FROM
     "CLEARINGINWARD" CLEARINGINWARD left outer join
     "BRANCHMSTR" BRANCHMSTR
on
    BRANCHMSTR."BRM_MICRCD"=CLEARINGINWARD."CLI_PAYORBANKROUTNO"
 left outer join "RETRUNOUTWARD" RETRUNOUTWARD
on  RETRUNOUTWARD."RTO_DDMMYYYY"  =CLEARINGINWARD."CLI_DDMMYYYY" and CLEARINGINWARD."CLI_CLRSRNO"=RETRUNOUTWARD."RTO_ITEMSEQUENCENO"
 left outer join "RETINWRETCODES" RETINWRETCODES 
 on  RETINWRETCODES."RETCODE"=RETRUNOUTWARD."RTO_RETURNREASONCODE"
where
   CLEARINGINWARD."CLI_DDMMYYYY"=$P{dateString}
AND
   nvl(BRANCHMSTR."BRM_BRNCD",'-1')=DECODE($P{branchString},'ALL',BRM_BRNCD,'-1','-1',$P{branchString})
AND  CLI_CLEARINGTYPE='99'
order by
BRANCHMSTR_BRM_BRNCD,
CLEARINGINWARD_CLI_XMLFILENAME ASC,
CLEARINGINWARD_CLI_PAYORBANKRO ASC]]></queryString>

