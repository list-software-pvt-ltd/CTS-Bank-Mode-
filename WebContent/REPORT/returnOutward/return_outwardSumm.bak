<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="return_outwardSumm"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="595"
		 pageHeight="842"
		 columnWidth="595"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="dateString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["01/01/2000"]]></defaultValueExpression>
	</parameter>
	<parameter name="clearingType" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["00"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[Select 
     BRANCHMSTR."BRM_BRNCD" as BRM_BRNCD,
     nvl(BRANCHMSTR."BRM_BRNNM",'Not Drawn On Us') as BRM_BRNNM,
     sum((RETRUNOUTWARD."RTO_AMOUNT")/100)AS RETRUNOUTWARD_CLO_AMOUNT,
     TO_CHAR(TO_DATE(RETRUNOUTWARD."RTO_DDMMYYYY",'DD/MM/YYYY'),'DD/MM/YYYY') AS RETRUNOUTWARD_RTO_DDMMYYYY,    
     count(RETRUNOUTWARD."RTO_CHEQUENO") AS RETRUNOUTWARD_CLO_CHQNO,
     (select count(RETRUNOUTWARD."RTO_CHEQUENO") from   "RETRUNOUTWARD" RETRUNOUTWARD where
     RETRUNOUTWARD."RTO_DDMMYYYY"=$P{dateString} and RTO_RETURNREASONCODE='00'  ) as ACCP_CHQ,
       (select count(RETRUNOUTWARD."RTO_CHEQUENO") from   "RETRUNOUTWARD" RETRUNOUTWARD where
     RETRUNOUTWARD."RTO_DDMMYYYY"=$P{dateString} and RTO_RETURNREASONCODE<>'00'  ) as REJ_CHQ,
     
     
     (select   sum((RETRUNOUTWARD."RTO_AMOUNT")/100)  from   "RETRUNOUTWARD" RETRUNOUTWARD where
     RETRUNOUTWARD."RTO_DDMMYYYY"=$P{dateString} and RTO_RETURNREASONCODE='00'  ) as ACCP_AMT,
       (select   sum((RETRUNOUTWARD."RTO_AMOUNT")/100) from   "RETRUNOUTWARD" RETRUNOUTWARD where
     RETRUNOUTWARD."RTO_DDMMYYYY"=$P{dateString} and RTO_RETURNREASONCODE<>'00'  ) as REJ_AMT
     
     FROM
     "RETRUNOUTWARD" RETRUNOUTWARD left outer join
     "BRANCHMSTR" BRANCHMSTR 
     on
        RETRUNOUTWARD."RTO_PAYORBANKROUTNO"=nvl(BRANCHMSTR."BRM_MICRCD",RETRUNOUTWARD."RTO_PAYORBANKROUTNO")
    where 
     RETRUNOUTWARD."RTO_DDMMYYYY"=$P{dateString}
     and 
     RETRUNOUTWARD."RTO_CLEARINGTYPE"= decode($P{clearingType},'0',RETRUNOUTWARD.RTO_CLEARINGTYPE,$P{clearingType})
    group by BRM_BRNCD,BRM_BRNNM,RTO_DDMMYYYY
    order by 1]]></queryString>

	<field name="BRM_BRNCD" class="java.math.BigDecimal"/>
	<field name="BRM_BRNNM" class="java.lang.String"/>
	<field name="RETRUNOUTWARD_CLO_AMOUNT" class="java.math.BigDecimal"/>
	<field name="RETRUNOUTWARD_RTO_DDMMYYYY" class="java.lang.String"/>
	<field name="RETRUNOUTWARD_CLO_CHQNO" class="java.math.BigDecimal"/>
	<field name="ACCP_CHQ" class="java.lang.Integer"/>
	<field name="REJ_CHQ" class="java.lang.Integer"/>
	<field name="ACCP_AMT" class="java.lang.Double"/>
	<field name="REJ_AMT" class="java.lang.Double"/>

	<variable name="Tot_Amount" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{RETRUNOUTWARD_CLO_AMOUNT}]]></variableExpression>
	</variable>
	<variable name="Tot_cheque" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
