	<queryString><![CDATA[SELECT
     RETRUNOUTWARD."RTO_BOFD" AS RETRUNOUTWARD_RTO_BOFD,
     RETRUNOUTWARD."RTO_CHEQUENO" AS RETRUNOUTWARD_RTO_CHEQUENO,
     RETRUNOUTWARD."RTO_SORTCODE" AS RETRUNOUTWARD_RTO_SORTCODE,
     RETRUNOUTWARD."RTO_TRANSACTIONCODE" AS RETRUNOUTWARD_RTO_TRANSACTIONC,
     RETRUNOUTWARD."RTO_AMOUNT" AS RETRUNOUTWARD_RTO_AMOUNT,
     RETRUNOUTWARD."RTO_ACCOUNTNUMBER" AS RETRUNOUTWARD_RTO_ACCOUNTNUMBE,
     TO_CHAR(TO_DATE(RETRUNOUTWARD."RTO_DDMMYYYY",'DD/MM/YYYY'),'DD/MM/YYYY') AS RETRUNOUTWARD_RTO_DDMMYYYY,
     substr(RETRUNOUTWARD."RTO_XMLFILENAME",1,29) AS RETRUNOUTWARD_RTO_XMLFILENAME,
      RETRUNOUTWARD."RTO_RETURNREASONCODE"||'--'||SUBSTR(RETDESCR, 1,decode((INSTR(RETDESCR, '(' )-1),'-1',length(RETDESCR) , (INSTR(RETDESCR, '(' )-1)))
||
decode(RETRUNOUTWARD."RTO_RETURNREASONCODE",'88','(' ||RETRUNOUTWARD."RTO_RETREASONCOMMT"||')',' ')  
  AS RETRUNOUTWARD_RTO_RETURNREASON,
     RETRUNOUTWARD."RTO_PAYORBANKROUTNO" AS CLEARINGINWARD_CLI_PAYORBANKRO
FROM
    "RETRUNOUTWARD" RETRUNOUTWARD join RETINWRETCODES on RTO_RETURNREASONCODE=RETCODE
WHERE
  RETRUNOUTWARD."RTO_DDMMYYYY"=$P{dateString}
order by
RETRUNOUTWARD_RTO_XMLFILENAME ASC,
RETRUNOUTWARD_RTO_SORTCODE]]></queryString>

