	<queryString><![CDATA[select RTI_PAYORBANKROUTNO,RTI_SERIALNO,RTI_AMOUNT,RTI_ACCOUNTNO,RTI_RETURNREASON,RTI_RETURNREASONCOMMENT,(select BRM_MICRCD from BRANCHMSTR where BRM_BRNCD=c.CLO_BRANCH_CD)as branchmicrcd,(select BRM_BRNNM from BRANCHMSTR where BRM_BRNCD=c.CLO_BRANCH_CD)as branchname,TO_CHAR(to_date(RTI_PRESENTMENTDATE,'dd/mm/yyyy'),'Day, ddth Month, yyyy')RTI_PRESENTMENTDATE,
 RTI_TRANSCODE,RTI_ITEMSEQNO,TO_CHAR(to_date(RTI_DDMMYYYY,'dd/mm/yyyy'),'Day, ddth Month, yyyy')RTI_DDMMYYYY,c.CLO_IMG_FRNT_GR,(SELECT TO_CHAR(to_date($P{todaysdt} ,'dd/mm/yyyy'),'Day, ddth Month, yyyy')"Today" FROM dual)datestr,cr.RETDESCR from RETURNINWARD join CLEARINGOUTWARD c  on RTI_ITEMSEQNO=CLO_ITEMSEQNO and RTI_PRESENTMENTDATE=c.CLO_DATE_DDMMYYYY join RETINWRETCODES cr on cr.RETCODE= RTI_RETURNREASON
                     where RTI_DDMMYYYY=$P{rtidate}  and c.CLO_DATE_DDMMYYYY=$P{clodate} and RTI_ITEMSEQNO=$P{rtiseqno}  and RTI_SERIALNO=$P{chqueno}]]></queryString>

