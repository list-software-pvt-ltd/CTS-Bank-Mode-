	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="dateString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["01012014"]]></defaultValueExpression>
	</parameter>
	<parameter name="branchString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="bankName" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="clearingType" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["00"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT
     RETURNINWARD."RTI_ITEMSEQNO" AS RETURNINWARD_RTI_ITEMSEQNO,
     RETURNINWARD."RTI_SERIALNO" AS RETURNINWARD_RTI_SERIALNO,
     RETURNINWARD."RTI_TRANSCODE" AS RETURNINWARD_RTI_TRANSCODE,
     RETURNINWARD."RTI_AMOUNT" AS RETURNINWARD_RTI_AMOUNT,
     RETURNINWARD."RTI_ACCOUNTNO" AS RETURNINWARD_RTI_ACCOUNTNO,
    --RETURNINWARD."RTI_RETURNREASONCOMMENT" AS RETURNINWARD_RTI_RETURNCOMMENT,
     RETINWRETCODES."RETDESCR" AS RETURNINWARD_RTI_RETURNCOMMENT ,
     TO_CHAR(TO_DATE(RETURNINWARD."RTI_DDMMYYYY",'DD/MM/YYYY'),'DD/MM/YYYY') AS RETURNINWARD_RTI_DDMMYYY,
     RETURNINWARD."RTI_PAYORBANKROUTNO" AS RETURNINWARD_RTI_PAYORBANKROUT,
     RETURNINWARD."RTI_RETURNREASON" AS RETURNINWARD_RTI_RETURNREASON,
     substr(RETURNINWARD."RTI_FILENAME",1,29) AS RETURNINWARD_RTI_FILENAME,
     CLEARINGOUTWARD."CLO_PAYEE_ACCNO" AS CLEARINGOUTWARD_CLO_PAYEE_ACCN,
     TRIM(CLEARINGOUTWARD."CLO_PAYEE_ACCNM") AS CLEARINGOUTWARD_CLO_PAYEE_ACNM,
     CLEARINGOUTWARD."CLO_CHQNO" AS CLEARINGOUTWARD_CLO_CHQNO,
     CLEARINGOUTWARD."CLO_SORTCD" AS CLEARINGOUTWARD_CLO_SORTCD,
     --CLEARINGOUTWARD."CLO_IQARESULTS" AS CLEARINGOUTWARD_CLO_IQARESULTS,
     CLEARINGOUTWARD."CLO_DRAWEE_ACCNO" AS CLEARINGOUTWARD_CLO_DRAWEE_ACC,
     CLEARINGOUTWARD."CLO_BRANCH_CD" AS CLEARINGOUTWARD_CLO_BRANCH_CD,
     TO_CHAR(TO_DATE(CLEARINGOUTWARD."CLO_DATE_DDMMYYYY",'DD/MM/YYYY'),'DD/MM/YYYY') AS CLO_DATE_DDMMYYYY,
     BRANCHMSTR."BRM_BRNCD"||'--'||BRANCHMSTR."BRM_BRNNM" AS BRM_CD_BRNNM ,
   decode(RETURNINWARD."RTI_RETURNREASON",'88','('||RETURNINWARD."RTI_RETURNREASONCOMMENT"||')',' ') RTI_RETURNREASONCOMMENT ,
     CLEARINGOUTWARD."CLO_BOFD" AS CLEARINGOUTWARD_CLO_BOFD,
    -- nvl((select BNK_NAME from BANKMASTER_CHM where BNK_ROUTING_NBR=(select BRN_BNK_ROUTING_NBR from BRANCHMASTER_CHM where BRN_ROUTING_NBR=CLEARINGOUTWARD."CLO_SORTCD")),CLO_SORTCD) BNK_NAME
	--nvl((select BNK_NAME from BANKMASTER_CHM where BNK_ROUTING_NBR=(select BRN_BNK_ROUTING_NBR from BRANCHMASTER_CHM where BRN_ROUTING_NBR=CLEARINGOUTWARD."CLO_SORTCD")),
     --nvl((select BNK_NAME from BANKMASTER_CHM where substr(BNK_ROUTING_NBR,1,6)=substr(CLO_SORTCD,1,6)),CLO_SORTCD)) BNK_NAME
	nvl((nvl((select BNK_NAME||' '||CLO_SORTCD from BANKMASTER_CHM where BNK_ROUTING_NBR=CLO_SORTCD),
	(select BNK_NAME||' '||CLO_SORTCD from BANKMASTER_CHM where BNK_ROUTING_NBR=
	(select distinct  BRN_BNK_ROUTING_NBR from BRANCHMASTER_CHM 
	where BRN_ROUTING_NBR=CLO_SORTCD )))),CLO_SORTCD) AS BNK_NAME,
	TO_CHAR(TO_DATE(RETURNINWARD."RTI_PRESENTMENTDATE",'DD/MM/YYYY'),'DD/MM/YYYY') AS RETINW_RTI_PRESENTMENTDATE
FROM
    "RETURNINWARD" RETURNINWARD join "CLEARINGOUTWARD" CLEARINGOUTWARD 
     on CLEARINGOUTWARD."CLO_CHQNO"=RETURNINWARD."RTI_SERIALNO"
    AND   CLEARINGOUTWARD."CLO_SORTCD"=RETURNINWARD."RTI_PAYORBANKROUTNO"
    AND CLEARINGOUTWARD."CLO_ITEMSEQNO"=nvl(RETURNINWARD."RTI_ITEMSEQNO",CLEARINGOUTWARD."CLO_ITEMSEQNO")
   AND to_number(CLEARINGOUTWARD."CLO_AMOUNT")=to_number(RETURNINWARD."RTI_AMOUNT")
   AND to_number(CLEARINGOUTWARD."CLO_TRANCD")=to_number(RETURNINWARD."RTI_TRANSCODE")
   AND CLEARINGOUTWARD."CLO_DATE_DDMMYYYY"=RETURNINWARD."RTI_PRESENTMENTDATE"
     join "BRANCHMSTR" BRANCHMSTR on BRANCHMSTR."BRM_BRNCD"=CLEARINGOUTWARD."CLO_BRANCH_CD"
     join "RETINWRETCODES" RETINWRETCODES on RETURNINWARD."RTI_RETURNREASON"=RETINWRETCODES."RETCODE"
WHERE
      RETURNINWARD."RTI_PRESENTMENTDATE" in (select DISTINCT RTI_PRESENTMENTDATE from RETURNINWARD 
WHERE RTI_DDMMYYYY=$P{dateString}) and RTI_DDMMYYYY=$P{dateString}
and 
    BRANCHMSTR."BRM_BRNCD"=decode($P{branchString},'-1',BRANCHMSTR."BRM_BRNCD",$P{branchString})
and 
    RETURNINWARD."RTI_CLEARINGTYPE"=
    decode($P{clearingType},'0',RETURNINWARD."RTI_CLEARINGTYPE",$P{clearingType})
  and RETURNINWARD."RTI_RETURNREASON"<>0
--AND
--    CLEARINGOUTWARD."CLO_DATE_DDMMYYYY"=to_char
--    ((select max(to_date(A.CLO_DATE_DDMMYYYY,'ddmmyyyy')) from CLEARINGOUTWARD A where 
--    RETURNINWARD."RTI_SERIALNO"=A.CLO_CHQNO and RETURNINWARD."RTI_PAYORBANKROUTNO"=
--    A.CLO_SORTCD),'ddmmyyyy')

order by
      RETURNINWARD_RTI_FILENAME,RETINW_RTI_PRESENTMENTDATE,BRM_CD_BRNNM,RETURNINWARD_RTI_ITEMSEQNO]]></queryString>

