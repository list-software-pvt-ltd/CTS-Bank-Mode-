<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="report_return_inward_All_withoutmemo"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="545"
		 pageHeight="842"
		 columnWidth="545"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<property name="ireport.encoding" value="UTF-8" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />

	<parameter name="dateString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["01012014"]]></defaultValueExpression>
	</parameter>
	<parameter name="branchString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="bankName" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="clearingType" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["00"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT
     RETURNINWARD."RTI_ITEMSEQNO" AS RETURNINWARD_RTI_ITEMSEQNO,
     RETURNINWARD."RTI_SERIALNO" AS RETURNINWARD_RTI_SERIALNO,
     RETURNINWARD."RTI_TRANSCODE" AS RETURNINWARD_RTI_TRANSCODE,
     RETURNINWARD."RTI_AMOUNT" AS RETURNINWARD_RTI_AMOUNT,
     RETURNINWARD."RTI_ACCOUNTNO" AS RETURNINWARD_RTI_ACCOUNTNO,
     --nvl(ITEMRETURNREASON_CHM."ITM_DESCRIPTION",'-') AS RETURNINWARD_RTI_RETURNCOMMENT,
     nvl(RETINWRETCODES."RETDESCR",'-') AS RETURNINWARD_RTI_RETURNCOMMENT ,
     TO_CHAR(TO_DATE(RETURNINWARD."RTI_DDMMYYYY",'DD/MM/YYYY'),'DD/MM/YYYY') AS RETURNINWARD_RTI_DDMMYYY,
     RETURNINWARD."RTI_PAYORBANKROUTNO" AS RETURNINWARD_RTI_PAYORBANKROUT,
     RETURNINWARD."RTI_RETURNREASON"   AS RETURNINWARD_RTI_RETURNREASON,
     substr(RETURNINWARD."RTI_FILENAME",1,29) AS RETURNINWARD_RTI_FILENAME,
     CLEARINGOUTWARD."CLO_PAYEE_ACCNO" AS CLEARINGOUTWARD_CLO_PAYEE_ACCN,
     CLEARINGOUTWARD."CLO_PAYEE_ACCNM" AS CLEARINGOUTWARD_CLO_PAYEE_ACNM,
     CLEARINGOUTWARD."CLO_CHQNO" AS CLEARINGOUTWARD_CLO_CHQNO,
     CLEARINGOUTWARD."CLO_SORTCD" AS CLEARINGOUTWARD_CLO_SORTCD,
     CLEARINGOUTWARD."CLO_DRAWEE_ACCNO" AS CLEARINGOUTWARD_CLO_DRAWEE_ACC,
     CLEARINGOUTWARD."CLO_BRANCH_CD" AS CLEARINGOUTWARD_CLO_BRANCH_CD,
     lpad(BRANCHMSTR."BRM_BRNCD",2,'0')||'--'||BRANCHMSTR."BRM_BRNNM" AS BRM_CD_BRNNM ,
      decode(RETURNINWARD."RTI_RETURNREASON",'88','('||RETURNINWARD."RTI_RETURNREASONCOMMENT"||')',' ') RTI_RETURNREASONCOMMENT ,
     CLEARINGOUTWARD."CLO_BOFD" AS CLEARINGOUTWARD_CLO_BOFD,
     --nvl(BANKMASTER_CHM."BNK_NAME","RETURNINWARD".RTI_PAYORBANKROUTNO) AS BANKMASTER_CHM_BANK_NAME
     --nvl((select BNK_NAME from BANKMASTER_CHM where BNK_ROUTING_NBR=(select BRN_BNK_ROUTING_NBR from BRANCHMASTER_CHM where BRN_ROUTING_NBR=CLEARINGOUTWARD."CLO_SORTCD")),CLO_SORTCD) BANKMASTER_CHM_BANK_NAME
   -- nvl((select BNK_NAME from BANKMASTER_CHM where BNK_ROUTING_NBR=(select distinct BRN_BNK_ROUTING_NBR from BRANCHMASTER_CHM where BRN_ROUTING_NBR= CLO_SORTCD )),
   -- nvl((select BNK_NAME from BANKMASTER_CHM where substr(BNK_ROUTING_NBR,1,6)=substr(CLO_SORTCD,1,6)),CLO_SORTCD)) BNK_NAME
	nvl((nvl((select BNK_NAME||' '||CLO_SORTCD from BANKMASTER_CHM where BNK_ROUTING_NBR=CLO_SORTCD),
	(select BNK_NAME||' '||CLO_SORTCD from BANKMASTER_CHM where BNK_ROUTING_NBR=
	(select distinct  BRN_BNK_ROUTING_NBR from BRANCHMASTER_CHM 
	where BRN_ROUTING_NBR=CLO_SORTCD )))),CLO_SORTCD) AS BNK_NAME,
	TO_CHAR(TO_DATE(RETURNINWARD."RTI_PRESENTMENTDATE",'DD/MM/YYYY'),'DD/MM/YYYY') AS RTI_PRESENTMENTDATE,
(select sum(RTI_AMOUNT/100)  from   "RETURNINWARD" RETURNINWARD join "CLEARINGOUTWARD" CLEARINGOUTWARD 
     on CLEARINGOUTWARD."CLO_CHQNO"=RETURNINWARD."RTI_SERIALNO"
    AND   CLEARINGOUTWARD."CLO_SORTCD"=RETURNINWARD."RTI_PAYORBANKROUTNO"
    AND CLEARINGOUTWARD."CLO_ITEMSEQNO"=nvl(RETURNINWARD."RTI_ITEMSEQNO",CLEARINGOUTWARD."CLO_ITEMSEQNO")
   AND to_number(CLEARINGOUTWARD."CLO_AMOUNT")=to_number(RETURNINWARD."RTI_AMOUNT")
   AND to_number(CLEARINGOUTWARD."CLO_TRANCD")=to_number(RETURNINWARD."RTI_TRANSCODE")
   AND CLEARINGOUTWARD."CLO_DATE_DDMMYYYY"=RETURNINWARD."RTI_PRESENTMENTDATE"
   join "BRANCHMSTR" BRANCHMSTR on BRANCHMSTR."BRM_MICRCD"=CLEARINGOUTWARD."CLO_BOFD"    
     join "RETINWRETCODES" RETINWRETCODES on RETURNINWARD."RTI_RETURNREASON"=RETINWRETCODES."RETCODE"
      where  RTI_DDMMYYYY=$P{dateString} and  RETURNINWARD."RTI_CLEARINGTYPE"=
   decode($P{clearingType},'0',RETURNINWARD."RTI_CLEARINGTYPE",$P{clearingType})
   AND   BRANCHMSTR."BRM_BRNCD"=decode($P{branchString},'-1',BRANCHMSTR."BRM_BRNCD",$P{branchString})
    and RTI_RETURNREASON not in (0,99)) as rej_amt,
(select sum(RTI_AMOUNT/100) from  "RETURNINWARD" RETURNINWARD join "CLEARINGOUTWARD" CLEARINGOUTWARD 
     on CLEARINGOUTWARD."CLO_CHQNO"=RETURNINWARD."RTI_SERIALNO"
    AND   CLEARINGOUTWARD."CLO_SORTCD"=RETURNINWARD."RTI_PAYORBANKROUTNO"
    AND CLEARINGOUTWARD."CLO_ITEMSEQNO"=nvl(RETURNINWARD."RTI_ITEMSEQNO",CLEARINGOUTWARD."CLO_ITEMSEQNO")
   AND to_number(CLEARINGOUTWARD."CLO_AMOUNT")=to_number(RETURNINWARD."RTI_AMOUNT")
   AND to_number(CLEARINGOUTWARD."CLO_TRANCD")=to_number(RETURNINWARD."RTI_TRANSCODE")
   AND CLEARINGOUTWARD."CLO_DATE_DDMMYYYY"=RETURNINWARD."RTI_PRESENTMENTDATE"
   join "BRANCHMSTR" BRANCHMSTR on BRANCHMSTR."BRM_MICRCD"=CLEARINGOUTWARD."CLO_BOFD"    
     join "RETINWRETCODES" RETINWRETCODES on RETURNINWARD."RTI_RETURNREASON"=RETINWRETCODES."RETCODE"
         where  RTI_DDMMYYYY=$P{dateString} and  RETURNINWARD."RTI_CLEARINGTYPE"=
   decode($P{clearingType},'0',RETURNINWARD."RTI_CLEARINGTYPE",$P{clearingType})
   AND   BRANCHMSTR."BRM_BRNCD"=decode($P{branchString},'-1',BRANCHMSTR."BRM_BRNCD",$P{branchString})
    and RTI_RETURNREASON  in (0)) as acpt_amt,
(select count(CLO_CHQNO)  from   "RETURNINWARD" RETURNINWARD join "CLEARINGOUTWARD" CLEARINGOUTWARD 
     on CLEARINGOUTWARD."CLO_CHQNO"=RETURNINWARD."RTI_SERIALNO"
    AND   CLEARINGOUTWARD."CLO_SORTCD"=RETURNINWARD."RTI_PAYORBANKROUTNO"
    AND CLEARINGOUTWARD."CLO_ITEMSEQNO"=nvl(RETURNINWARD."RTI_ITEMSEQNO",CLEARINGOUTWARD."CLO_ITEMSEQNO")
   AND to_number(CLEARINGOUTWARD."CLO_AMOUNT")=to_number(RETURNINWARD."RTI_AMOUNT")
   AND to_number(CLEARINGOUTWARD."CLO_TRANCD")=to_number(RETURNINWARD."RTI_TRANSCODE")
   AND CLEARINGOUTWARD."CLO_DATE_DDMMYYYY"=RETURNINWARD."RTI_PRESENTMENTDATE"
   join "BRANCHMSTR" BRANCHMSTR on BRANCHMSTR."BRM_MICRCD"=CLEARINGOUTWARD."CLO_BOFD"    
     join "RETINWRETCODES" RETINWRETCODES on RETURNINWARD."RTI_RETURNREASON"=RETINWRETCODES."RETCODE"
      where  RTI_DDMMYYYY=$P{dateString} and  RETURNINWARD."RTI_CLEARINGTYPE"=
   decode($P{clearingType},'0',RETURNINWARD."RTI_CLEARINGTYPE",$P{clearingType})
   AND   BRANCHMSTR."BRM_BRNCD"=decode($P{branchString},'-1',BRANCHMSTR."BRM_BRNCD",$P{branchString})
    and RTI_RETURNREASON not in (0,99)) as rej_chq_cnt,
(select count(CLO_CHQNO)  from   "RETURNINWARD" RETURNINWARD join "CLEARINGOUTWARD" CLEARINGOUTWARD 
     on CLEARINGOUTWARD."CLO_CHQNO"=RETURNINWARD."RTI_SERIALNO"
    AND   CLEARINGOUTWARD."CLO_SORTCD"=RETURNINWARD."RTI_PAYORBANKROUTNO"
    AND CLEARINGOUTWARD."CLO_ITEMSEQNO"=nvl(RETURNINWARD."RTI_ITEMSEQNO",CLEARINGOUTWARD."CLO_ITEMSEQNO")
   AND to_number(CLEARINGOUTWARD."CLO_AMOUNT")=to_number(RETURNINWARD."RTI_AMOUNT")
   AND to_number(CLEARINGOUTWARD."CLO_TRANCD")=to_number(RETURNINWARD."RTI_TRANSCODE")
   AND CLEARINGOUTWARD."CLO_DATE_DDMMYYYY"=RETURNINWARD."RTI_PRESENTMENTDATE"
   join "BRANCHMSTR" BRANCHMSTR on BRANCHMSTR."BRM_MICRCD"=CLEARINGOUTWARD."CLO_BOFD"    
     join "RETINWRETCODES" RETINWRETCODES on RETURNINWARD."RTI_RETURNREASON"=RETINWRETCODES."RETCODE"
      where  RTI_DDMMYYYY=$P{dateString} and  RETURNINWARD."RTI_CLEARINGTYPE"=
   decode($P{clearingType},'0',RETURNINWARD."RTI_CLEARINGTYPE",$P{clearingType})
   AND   BRANCHMSTR."BRM_BRNCD"=decode($P{branchString},'-1',BRANCHMSTR."BRM_BRNCD",$P{branchString})
    and RTI_RETURNREASON in (0))as acc_chq_cnt,

(select sum(RTI_AMOUNT/100)  from   "RETURNINWARD" RETURNINWARD join "CLEARINGOUTWARD" CLEARINGOUTWARD 
     on CLEARINGOUTWARD."CLO_CHQNO"=RETURNINWARD."RTI_SERIALNO"
    AND   CLEARINGOUTWARD."CLO_SORTCD"=RETURNINWARD."RTI_PAYORBANKROUTNO"
    AND CLEARINGOUTWARD."CLO_ITEMSEQNO"=nvl(RETURNINWARD."RTI_ITEMSEQNO",CLEARINGOUTWARD."CLO_ITEMSEQNO")
   AND to_number(CLEARINGOUTWARD."CLO_AMOUNT")=to_number(RETURNINWARD."RTI_AMOUNT")
   AND to_number(CLEARINGOUTWARD."CLO_TRANCD")=to_number(RETURNINWARD."RTI_TRANSCODE")
   AND CLEARINGOUTWARD."CLO_DATE_DDMMYYYY"=RETURNINWARD."RTI_PRESENTMENTDATE"
   join "BRANCHMSTR" BRANCHMSTR on BRANCHMSTR."BRM_MICRCD"=CLEARINGOUTWARD."CLO_BOFD"    
     join "RETINWRETCODES" RETINWRETCODES on RETURNINWARD."RTI_RETURNREASON"=RETINWRETCODES."RETCODE"
      where  RTI_DDMMYYYY=$P{dateString} and  RETURNINWARD."RTI_CLEARINGTYPE"=
   decode($P{clearingType},'0',RETURNINWARD."RTI_CLEARINGTYPE",$P{clearingType})
   AND   BRANCHMSTR."BRM_BRNCD"=decode($P{branchString},'-1',BRANCHMSTR."BRM_BRNCD",$P{branchString})
    and RTI_RETURNREASON  in (99)) as deemed_amt,
(select count(CLO_CHQNO)  from   "RETURNINWARD" RETURNINWARD join "CLEARINGOUTWARD" CLEARINGOUTWARD 
     on CLEARINGOUTWARD."CLO_CHQNO"=RETURNINWARD."RTI_SERIALNO"
    AND   CLEARINGOUTWARD."CLO_SORTCD"=RETURNINWARD."RTI_PAYORBANKROUTNO"
    AND CLEARINGOUTWARD."CLO_ITEMSEQNO"=nvl(RETURNINWARD."RTI_ITEMSEQNO",CLEARINGOUTWARD."CLO_ITEMSEQNO")
   AND to_number(CLEARINGOUTWARD."CLO_AMOUNT")=to_number(RETURNINWARD."RTI_AMOUNT")
   AND to_number(CLEARINGOUTWARD."CLO_TRANCD")=to_number(RETURNINWARD."RTI_TRANSCODE")
   AND CLEARINGOUTWARD."CLO_DATE_DDMMYYYY"=RETURNINWARD."RTI_PRESENTMENTDATE"
   join "BRANCHMSTR" BRANCHMSTR on BRANCHMSTR."BRM_MICRCD"=CLEARINGOUTWARD."CLO_BOFD"    
     join "RETINWRETCODES" RETINWRETCODES on RETURNINWARD."RTI_RETURNREASON"=RETINWRETCODES."RETCODE"
      where  RTI_DDMMYYYY=$P{dateString} and  RETURNINWARD."RTI_CLEARINGTYPE"=
   decode($P{clearingType},'0',RETURNINWARD."RTI_CLEARINGTYPE",$P{clearingType})
   AND   BRANCHMSTR."BRM_BRNCD"=decode($P{branchString},'-1',BRANCHMSTR."BRM_BRNCD",$P{branchString})
    and RTI_RETURNREASON in (99)) as deemed_chq
FROM
    "RETURNINWARD" RETURNINWARD join "CLEARINGOUTWARD" CLEARINGOUTWARD 
     on CLEARINGOUTWARD."CLO_CHQNO"=RETURNINWARD."RTI_SERIALNO"
    AND   CLEARINGOUTWARD."CLO_SORTCD"=RETURNINWARD."RTI_PAYORBANKROUTNO"
    AND CLEARINGOUTWARD."CLO_ITEMSEQNO"=nvl(RETURNINWARD."RTI_ITEMSEQNO",CLEARINGOUTWARD."CLO_ITEMSEQNO")
   AND to_number(CLEARINGOUTWARD."CLO_AMOUNT")=to_number(RETURNINWARD."RTI_AMOUNT")
   AND to_number(CLEARINGOUTWARD."CLO_TRANCD")=to_number(RETURNINWARD."RTI_TRANSCODE")
   AND CLEARINGOUTWARD."CLO_DATE_DDMMYYYY"=RETURNINWARD."RTI_PRESENTMENTDATE"
   join "BRANCHMSTR" BRANCHMSTR on BRANCHMSTR."BRM_MICRCD"=CLEARINGOUTWARD."CLO_BOFD"
     --left outer join "BANKMASTER_CHM" BANKMASTER_CHM on substr("RETURNINWARD".RTI_PAYORBANKROUTNO,1,6)=
     --substr(BANKMASTER_CHM."BNK_ROUTING_NBR",1,6)
    -- left outer join "ITEMRETURNREASON_CHM" ITEMRETURNREASON_CHM on ITEMRETURNREASON_CHM."ITM_RETURN_REASON_CODE"
    -- =RETURNINWARD."RTI_RETURNREASON" 
     join "RETINWRETCODES" RETINWRETCODES on RETURNINWARD."RTI_RETURNREASON"=RETINWRETCODES."RETCODE"
WHERE
      RETURNINWARD."RTI_PRESENTMENTDATE" in (select DISTINCT RTI_PRESENTMENTDATE from RETURNINWARD 
WHERE RTI_DDMMYYYY=$P{dateString})   and RTI_DDMMYYYY=$P{dateString}
and 
    BRANCHMSTR."BRM_BRNCD"=decode($P{branchString},'-1',BRANCHMSTR."BRM_BRNCD",$P{branchString})
and 
    RETURNINWARD."RTI_CLEARINGTYPE"=
    decode($P{clearingType},'0',RETURNINWARD."RTI_CLEARINGTYPE",$P{clearingType})
--AND
--    CLEARINGOUTWARD."CLO_DATE_DDMMYYYY"=to_char
--    ((select max(to_date(A.CLO_DATE_DDMMYYYY,'ddmmyyyy')) from CLEARINGOUTWARD A where 
--    RETURNINWARD."RTI_SERIALNO"=A.CLO_CHQNO and RETURNINWARD."RTI_PAYORBANKROUTNO"=
--    A.CLO_SORTCD),'ddmmyyyy')
order by
      RETURNINWARD_RTI_FILENAME,RTI_PRESENTMENTDATE,BRM_CD_BRNNM,RETURNINWARD_RTI_ITEMSEQNO]]></queryString>

	<field name="RETURNINWARD_RTI_ITEMSEQNO" class="java.lang.String"/>
	<field name="RETURNINWARD_RTI_SERIALNO" class="java.lang.String"/>
	<field name="RETURNINWARD_RTI_TRANSCODE" class="java.lang.String"/>
	<field name="RETURNINWARD_RTI_AMOUNT" class="java.lang.String"/>
	<field name="RETURNINWARD_RTI_ACCOUNTNO" class="java.lang.String"/>
	<field name="RETURNINWARD_RTI_RETURNCOMMENT" class="java.lang.String"/>
	<field name="RETURNINWARD_RTI_DDMMYYY" class="java.lang.String"/>
	<field name="RETURNINWARD_RTI_PAYORBANKROUT" class="java.lang.String"/>
	<field name="RETURNINWARD_RTI_RETURNREASON" class="java.lang.String"/>
	<field name="RETURNINWARD_RTI_FILENAME" class="java.lang.String"/>
	<field name="CLEARINGOUTWARD_CLO_PAYEE_ACCN" class="java.lang.String"/>
	<field name="CLEARINGOUTWARD_CLO_PAYEE_ACNM" class="java.lang.String"/>
	<field name="CLEARINGOUTWARD_CLO_CHQNO" class="java.lang.String"/>
	<field name="CLEARINGOUTWARD_CLO_SORTCD" class="java.lang.String"/>
	<field name="CLEARINGOUTWARD_CLO_DRAWEE_ACC" class="java.lang.String"/>
	<field name="CLEARINGOUTWARD_CLO_BRANCH_CD" class="java.lang.String"/>
	<field name="BRM_CD_BRNNM" class="java.lang.String"/>
	<field name="RTI_RETURNREASONCOMMENT" class="java.lang.String"/>
	<field name="CLEARINGOUTWARD_CLO_BOFD" class="java.lang.String"/>
	<field name="BNK_NAME" class="java.lang.String"/>
	<field name="RTI_PRESENTMENTDATE" class="java.lang.String"/>
	<field name="REJ_AMT" class="java.math.BigDecimal"/>
	<field name="ACPT_AMT" class="java.math.BigDecimal"/>
	<field name="REJ_CHQ_CNT" class="java.lang.Integer"/>
	<field name="ACC_CHQ_CNT" class="java.lang.Integer"/>
	<field name="DEEMED_AMT" class="java.math.BigDecimal"/>
	<field name="DEEMED_CHQ" class="java.lang.Integer"/>

	<variable name="sessionNumber" class="java.lang.Integer" resetType="Report" incrementType="Group" incrementGroup="sessionGroup" calculation="Count">
		<variableExpression><![CDATA[$V{sessionNumber}]]></variableExpression>
		<initialValueExpression><![CDATA[new Integer(1)]]></initialValueExpression>
	</variable>
	<variable name="sessionTotAmt" class="java.lang.Double" resetType="Group" resetGroup="sessionGroup" calculation="Sum">
		<variableExpression><![CDATA[new Double(Double.parseDouble($F{RETURNINWARD_RTI_AMOUNT})/100)]]></variableExpression>
	</variable>
	<variable name="grandTotAmt" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[new Double(Double.parseDouble($F{RETURNINWARD_RTI_AMOUNT})/100)]]></variableExpression>
	</variable>
	<variable name="brnTotAmt" class="java.lang.Double" resetType="Group" resetGroup="branchGroup" calculation="Sum">
		<variableExpression><![CDATA[new Double(Double.parseDouble($F{RETURNINWARD_RTI_AMOUNT})/100)]]></variableExpression>
	</variable>
	<variable name="srno" class="java.lang.Integer" resetType="Report" incrementType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new Integer($V{srno}.intValue()+1)]]></variableExpression>
		<initialValueExpression><![CDATA[new Integer(0)]]></initialValueExpression>
	</variable>

		<group  name="sessionGroup" >
			<groupExpression><![CDATA[$F{RETURNINWARD_RTI_FILENAME}]]></groupExpression>
			<groupHeader>
			<band height="0"  isSplitAllowed="true" >
			</band>
			</groupHeader>
			<groupFooter>
			<band height="0"  isSplitAllowed="true" >
