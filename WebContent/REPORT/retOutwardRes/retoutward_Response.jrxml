	<parameter name="dateString" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["01012014"]]></defaultValueExpression>
	</parameter>
	<parameter name="bankName" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select (sum(RTO_AMOUNT)/100)RTO_AMOUNT, RTO_XMLFILENAME, RTO_FILESTATUS, RTO_REJECTREASON,
to_char(to_date(RTO_DDMMYYYY,'dd/mm/yyyy'),'dd/mm/yyyy')RTO_DDMMYYYY 
from RETRUNOUTWARD where
RTO_DDMMYYYY=$P{dateString} 
and  RTO_FILESTATUS is not null 
and RTO_REJECTREASON  is not null 
group by RTO_XMLFILENAME, RTO_FILESTATUS, RTO_REJECTREASON,RTO_DDMMYYYY
order by RTO_XMLFILENAME]]></queryString>

	<field name="RTO_AMOUNT" class="java.math.BigDecimal"/>
	<field name="RTO_XMLFILENAME" class="java.lang.String"/>
	<field name="RTO_FILESTATUS" class="java.lang.String"/>
	<field name="RTO_REJECTREASON" class="java.lang.String"/>
	<field name="RTO_DDMMYYYY" class="java.lang.String"/>

	<variable name="amount" class="java.math.BigDecimal" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[$F{RTO_AMOUNT}]]></variableExpression>
	</variable>
	<variable name="grandTotAmt" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{RTO_AMOUNT}]]></variableExpression>
	</variable>
	<variable name="brnTotAmt" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$V{amount}]]></variableExpression>
	</variable>
	<variable name="srNo" class="java.lang.Integer" resetType="Report" calculation="Nothing">
		<variableExpression><![CDATA[new Integer($V{srNo}.intValue()+1)]]></variableExpression>
		<initialValueExpression><![CDATA[new Integer(0)]]></initialValueExpression>
	</variable>
	<variable name="totAmt" class="java.math.BigDecimal" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{RTO_AMOUNT}]]></variableExpression>
	</variable>
